@import "../../../style/design_v3.wxss";
page{background:#f8faf9}.living-tabs{display:flex;margin:0 26rpx 15rpx;background:#ecf2ee;border-radius:50rpx;padding:5rpx}.living-tabs button{flex:1;border-radius:45rpx;background:transparent;font-size:25rpx;color:#83938a;line-height:75rpx}.living-tabs .active{background:#087f70;color:white}.living-list{margin:0 26rpx;padding:0 22rpx;background:white;border-radius:20rpx}.living-row{display:flex;align-items:center;text-align:left;gap:22rpx;background:white;padding:25rpx 0;border-bottom:1rpx solid #eef2ef}.living-row>image,.living-placeholder{width:192rpx;height:145rpx;border-radius:14rpx;flex-shrink:0}.living-placeholder{background:#eaf3ed;color:#729885;font-size:45rpx;display:flex;align-items:center;justify-content:center}.living-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:12rpx;line-height:1.45}.living-copy>text:first-child{font-size:29rpx;font-weight:600;color:#263d30}.living-copy>text:nth-child(2){font-size:23rpx;color:#8b9b91}.living-copy>text:last-child{font-size:21rpx;color:#559380}.living-travel{margin:0 26rpx}.living-footer{background:transparent;margin:30rpx auto;color:#82998a;font-size:24rpx}.living-retry{font-size:24rpx;color:#087f70;background:#edf6f0}

.living-call{width:88rpx;min-width:88rpx;height:88rpx;border-radius:50%;color:#fff;background:#146c60;padding:0;line-height:88rpx;font-size:34rpx}.living-call:after{border:0}
.living-load-more{margin:26rpx;min-height:88rpx;line-height:88rpx;background:#edf5f2;color:#146c60;font-size:26rpx;border-radius:44rpx}.living-retry{margin:20rpx 26rpx;min-height:88rpx;line-height:1.5;padding:22rpx;font-size:25rpx;border-radius:20rpx}.living-call{flex-shrink:0}
