<page-meta page-style="--wt-font-scale:{{wtFontScale||1}};--wt-entry-caption-lines:{{wtFontScale>1?2:1}};--wt-entry-title-bottom:{{wtFontScale>1?62:31}}rpx;"/>
<wxs module="media" src="../../../../../wxs/media.wxs"/>
<wxs module="rich" src="../../../../../wxs/rich_text.wxs"/>
<scenic-nav-bar title="攻略详情" bind:layout="bindScenicLayout"/><view wx:if="{{isLoad===null}}" class="wt-state">该攻略暂不可查看，请返回选择其他内容。</view><view wx:elif="{{!isLoad}}" class="wt-state">正在加载攻略…</view><block wx:else><view class="travel-hero {{wtDisplayMode==='enlarged'?'display-enlarged':''}}"><image wx:if="{{album.ALBUM_OBJ.cover[0] && album.ALBUM_OBJ.cover[0]!='/images/cover.gif'}}" class="travel-hero-image" src="{{media.display(album.ALBUM_OBJ.cover[0],mediaUrls)}}" mode="aspectFill"/><view class="travel-hero-shade"/><view class="travel-hero-copy"><text class="travel-hero-title">{{album.ALBUM_TITLE}}</text><text class="travel-hero-subtitle">{{album.ALBUM_OBJ.desc||album.ALBUM_CATE_NAME}}</text></view></view><view class="travel-body {{wtDisplayMode==='enlarged'?'display-enlarged':''}}"><view wx:if="{{album.ALBUM_DEMO}}" class="demo-notice">演示攻略 · 景点、路线与时长仅供界面预览</view><view class="travel-meta"><text wx:if="{{spots.length}}"><text class="icon-location"/> {{spots.length}} 个景点</text><text wx:if="{{album.ALBUM_DURATION}}"><text class="icon-time"/> {{album.ALBUM_DURATION}}</text><text wx:if="{{album.ALBUM_VIEW_CNT}}"><text class="icon-attention"/> {{album.ALBUM_VIEW_CNT}} 次浏览</text></view><view wx:if="{{introText}}" class="travel-description">{{introText}}</view><view wx:if="{{highlights.length}}" class="travel-section"><text class="travel-section-title">路线亮点</text><view class="travel-highlights"><view wx:for="{{highlights}}" wx:key="_id" class="travel-highlight"><image src="{{media.display(item.cover,mediaUrls)}}" mode="aspectFill"/><text>{{item.highlight||item.PRODUCT_TITLE}}</text></view></view></view><view wx:if="{{spots.length}}" class="travel-section"><text class="travel-section-title">行程路线</text><view class="travel-itinerary"><button wx:for="{{spots}}" wx:key="_id" class="travel-stop" bindtap="url" data-url="../../product/detail/product_detail?id={{item._id}}"><view class="travel-stop-dot">{{index+1}}</view><image wx:if="{{item.cover && item.cover!='/images/cover.gif'}}" src="{{media.display(item.cover,mediaUrls)}}" mode="aspectFill"/><view class="travel-stop-copy"><text>{{item.PRODUCT_TITLE}}</text><text>{{item.note||item.PRODUCT_OBJ.address||'查看景点详情'}}</text></view><text wx:if="{{item.duration}}" class="travel-stop-time">{{item.duration}}</text><text wx:else class="icon-right"/></button></view></view><view wx:if="{{album.ALBUM_OBJ.detail.length}}" class="travel-section"><text class="travel-section-title">攻略介绍</text><block wx:for="{{album.ALBUM_OBJ.detail}}" wx:key="index"><text wx:if="{{item.type==='text'}}" class="travel-text" style="{{rich.style(item)}}" user-select>{{item.val}}</text><image wx:elif="{{item.type==='img'}}" class="travel-content-image" src="{{media.display(item.val,mediaUrls)}}" mode="widthFix" bindtap="url" data-type="img" data-url="{{item.val}}"/></block></view></view><cmpt-detail doFav="{{false}}" mode="guide" doHome="{{false}}" doTop="{{false}}" doShare="{{false}}" doPoster="{{false}}" oid="{{album._id}}" cate="{{album.ALBUM_CATE_NAME}}" title="{{album.ALBUM_TITLE}}" cover="{{album.ALBUM_OBJ.cover[0]}}"/></block>
<reading-tools id="readingTools"/>
