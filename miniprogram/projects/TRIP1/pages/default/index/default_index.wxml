<wxs module="media" src="../../../../../wxs/media.wxs"/>
<view class="portal"><scenic-nav-bar bind:layout="bindScenicLayout" mode="{{homeNavMode}}" title="{{portalBrandName}}" subtitle="{{homeNavMode==='home'?'拾光小镇 · 遇见日常好时光':''}}" brand="{{homeNavMode==='home'}}" back="{{false}}" overlay/>
<view class="portal-hero" style="height:calc(380rpx + {{uiChrome.height||88}}px)">
  <view wx:if="{{heroLoading&&!heroSlides.length}}" class="portal-hero-loading"/>
  <swiper wx:if="{{heroRender&&heroSlides.length}}" class="portal-hero-swiper" autoplay="{{heroPlaying&&heroSlides.length>1}}" circular="{{heroSlides.length>1}}" interval="5000" duration="500" current="{{heroIndex}}" bindchange="bindHeroChange" aria-label="小镇内容轮播">
    <swiper-item wx:for="{{heroSlides}}" wx:key="index">
      <image class="portal-slide-image" src="{{media.display(item.image,mediaUrls)}}" mode="aspectFill" data-index="{{index}}" bindload="heroImageLoaded" binderror="heroImageError"/>
      <view class="portal-shade"/>
      <view class="portal-title">{{item.title||'江纺1953'}}</view>
      <view wx:if="{{item.subtitle}}" class="portal-subtitle">{{item.subtitle}}</view>
      <button wx:if="{{item.path}}" class="portal-slide-link" bindtap="heroTap" data-index="{{index}}" aria-label="{{item.title||item.label}}，查看详情"/>
    </swiper-item>
  </swiper>
  <button wx:if="{{heroSlides.length&&heroImageErrors[heroIndex]}}" class="portal-image-retry" bindtap="retryHero">图片暂不可用，点击重试</button>
  <view wx:if="{{heroSlides.length>1}}" class="portal-dots"><view wx:for="{{heroSlides}}" wx:key="index" class="{{heroIndex===index?'active':''}}"/></view>
  <text wx:if="{{heroSlides.length}}" class="portal-slide-count" aria-label="第{{heroIndex+1}}张，共{{heroSlides.length}}张">{{heroIndex+1}}/{{heroSlides.length}}</text>
</view>
<view class="portal-body">
<text wx:if="{{homeUiPreview}}" class="portal-preview-notice">本地 UI 预览 · 以下活动为示例内容</text>
<view class="portal-entry-cards">
<button class="portal-entry-card" hover-class="portal-card-pressed" bindtap="url" data-url="{{scenicAboutUrl}}"><image class="portal-entry-image" src="/projects/TRIP1/images/town/intro-card-v1.jpg" mode="aspectFill"/><view class="portal-entry-shade"/><view class="portal-entry-copy"><view class="portal-card-icon-wrap"><image class="portal-card-icon" src="/projects/TRIP1/images/ui/home/mountains-green.png" mode="aspectFit"/></view><text class="portal-entry-title">园区简介</text><text class="portal-entry-caption">走进小镇，了解江纺故事</text></view><text class="portal-entry-arrow icon-right"/></button>
<button class="portal-entry-card" hover-class="portal-card-pressed" bindtap="url" data-url="../../experience/webview/panorama_webview"><image class="portal-entry-image" src="/projects/TRIP1/images/town/panorama-card-v1.jpg" mode="aspectFill"/><view class="portal-entry-shade"/><view class="portal-entry-copy"><view class="portal-card-icon-wrap"><image class="portal-card-icon" src="/projects/TRIP1/images/ui/home/landscape-green.png" mode="aspectFit"/></view><text class="portal-entry-title">全景</text><text class="portal-entry-caption">沉浸式探索拾光小镇</text></view><text class="portal-entry-arrow icon-right"/></button>
</view>
<view class="portal-entry-utilities">
<button hover-class="portal-card-pressed" bindtap="url" data-type="relaunch" data-url="../../album/index/album_index"><view class="portal-utility-icon"><image src="/projects/TRIP1/images/ui/home/guide.png" mode="aspectFit"/></view><view class="portal-utility-copy"><text class="portal-entry-title">园区攻略</text><text class="portal-utility-caption">游玩路线·必体验</text></view><text class="portal-utility-arrow icon-right"/></button>
<button hover-class="portal-card-pressed" bindtap="url" data-url="../../about/service/about_service"><view class="portal-utility-icon"><image src="/projects/TRIP1/images/ui/home/food.png" mode="aspectFit"/></view><view class="portal-utility-copy"><text class="portal-entry-title">吃住行</text><text class="portal-utility-caption">美食·住宿·交通</text></view><text class="portal-utility-arrow icon-right"/></button>
<button hover-class="portal-card-pressed" bindtap="url" data-url="../../feedback/index/feedback_index"><view class="portal-utility-icon"><image src="/projects/TRIP1/images/ui/home/feedback.png" mode="aspectFit"/></view><view class="portal-utility-copy"><text class="portal-entry-title">意见反馈</text><text class="portal-utility-caption">倾听你的声音</text></view><text class="portal-utility-arrow icon-right"/></button>
</view>
<view class="portal-news-section"><view class="portal-section"><view class="portal-activity-heading"><image class="portal-leaf" src="/projects/TRIP1/images/ui/home/leaf.png" mode="aspectFit"/><view class="portal-section-copy"><text class="portal-section-title">活动资讯</text><text class="portal-section-subtitle">小镇新鲜事 · 精彩不打烊</text></view></view><button class="portal-section-more" bindtap="bindAllNews">查看更多 <text class="icon-right"/></button></view><news-waterfall compact="{{true}}" media-urls="{{mediaUrls}}" items="{{waterfallItems}}"/>
<view wx:if="{{homeLoading&&!hasHomeLoaded&&!homeError}}" class="wt-state">正在发现精彩…</view>
<view wx:if="{{!waterfallItems.length&&(homeError||!homeLoading)}}" class="portal-empty">
  <text class="portal-empty-copy">{{homeError?'暂时无法获取资讯':'新的园区故事，即将与你相遇'}}</text>
  <button wx:if="{{homeError}}" class="portal-retry-button {{homeLoading?'is-loading':''}}" hover-class="portal-retry-pressed" bindtap="_loadList" loading="{{homeLoading}}" disabled="{{homeLoading}}" aria-label="{{homeLoading?'正在重新加载资讯':'重新加载资讯'}}"><text wx:if="{{!homeLoading}}" class="portal-retry-icon icon-refresh"/><text>{{homeLoading?'正在加载':'重新加载'}}</text></button>
</view></view>
<view class="portal-footer"><text>江纺1953 · 拾光小镇</text><text>逛街区 · 品美食 · 拾光慢生活</text></view></view></view>
