@import "../../../style/design_v3.wxss";
.panorama-page{min-height:100vh;background:#fff}.panorama-stage{height:70vh;position:relative;background:#245b4a;color:white}.panorama-stage>image,.panorama-shade{position:absolute;width:100%;height:100%}.panorama-shade{background:linear-gradient(180deg,rgba(9,39,36,.2),transparent 30%,rgba(9,39,36,.5))}.panorama-caption{position:absolute;left:32rpx;bottom:62rpx;display:flex;flex-direction:column;gap:15rpx}.panorama-caption>text:first-child{font-family:STSong,serif;font-size:50rpx;font-weight:600}.panorama-caption>text:last-child{font-size:23rpx;letter-spacing:2rpx}.panorama-play{position:absolute;left:50%;top:44%;transform:translateX(-50%);background:rgba(15,59,50,.55);color:white;border:2rpx solid rgba(255,255,255,.8);border-radius:50%;width:116rpx;height:116rpx;line-height:110rpx;font-size:42rpx;padding:0}.panorama-enlarge{position:absolute;bottom:24rpx;right:26rpx;border-radius:40rpx;background:rgba(255,255,255,.2);font-size:21rpx;color:white}.panorama-bottom{position:relative;border-radius:26rpx 26rpx 0 0;margin-top:-20rpx;background:white;padding:24rpx 22rpx}.panorama-thumbs{display:flex;gap:12rpx}.panorama-thumbs button{flex:1;padding:0;background:white;font-size:21rpx;line-height:1.7;color:#61746a}.panorama-thumbs image{width:100%;height:113rpx;border-radius:12rpx;border:3rpx solid transparent;box-sizing:border-box}.panorama-thumbs .selected image{border-color:#087f70}.panorama-thumbs .selected{color:#087f70;font-weight:600}.panorama-actions{display:flex;align-items:center;justify-content:space-between;padding:25rpx 35rpx 15rpx}.panorama-actions button{background:#f3f6f4;border-radius:40rpx;color:#7d8c84;font-size:24rpx;margin:0;line-height:74rpx}.panorama-actions .play{height:102rpx;width:102rpx;background:#087f70;color:white;font-size:37rpx;line-height:102rpx;padding:0;border-radius:50%}.panorama-note{display:block;text-align:center;font-size:21rpx;color:#a1ada5}

.panorama-thumbs{display:block;white-space:nowrap;width:100%}.panorama-thumbs button{display:inline-block;width:160rpx;margin-right:14rpx;white-space:normal;vertical-align:top}.panorama-bottom{padding-bottom:calc(32rpx + env(safe-area-inset-bottom))}.panorama-empty{padding:160rpx 40rpx;display:flex;flex-direction:column;gap:24rpx;text-align:center;color:#7b8b85;font-size:28rpx}.panorama-empty>text:first-child{font-size:66rpx;color:#146c60}.panorama-empty>text:nth-child(3){font-size:24rpx}.panorama-empty button,.panorama-load{min-height:88rpx;line-height:88rpx;background:#edf5f1;color:#146c60;border-radius:44rpx;font-size:26rpx;margin-top:16rpx}.panorama-play[disabled],.panorama-actions .play[disabled]{opacity:.4}
