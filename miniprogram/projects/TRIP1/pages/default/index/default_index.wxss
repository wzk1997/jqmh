page{padding-bottom:calc(128rpx + env(safe-area-inset-bottom));box-sizing:border-box}

.portal-travel-note{left:auto;right:26rpx;transform:none;font-size:19rpx;letter-spacing:0;padding:13rpx 16rpx}.portal-open{font-size:20rpx;padding:12rpx 14rpx}

.portal-section{width:100%;min-height:88rpx;margin:12rpx 0 16rpx;gap:14rpx;box-sizing:border-box}.portal-section .portal-section-copy{flex:1;min-width:0;display:flex;flex-direction:row;align-items:baseline;gap:14rpx}.portal-section-title{position:relative;display:block;white-space:nowrap;padding-left:17rpx;font-size:32rpx;font-weight:600;line-height:1.45}.portal-section-title:before{content:'';position:absolute;left:0;top:7rpx;bottom:7rpx;width:6rpx;border-radius:4rpx;background:#146c60}.portal-section-subtitle{font-size:24rpx;white-space:nowrap;color:#7d898e}.portal-section .portal-section-more{flex-shrink:0;display:flex;align-items:center;gap:8rpx;min-height:88rpx;padding:0;margin:0;font-size:24rpx;line-height:1.4;white-space:nowrap;background:transparent;color:#77848d}.portal-section-more .icon-right{font-size:25rpx}@media(max-width:350px){.portal-section-subtitle{display:none}}

.portal-section .portal-section-copy .portal-section-title{font-size:32rpx;font-weight:600}.portal-section .portal-section-copy .portal-section-subtitle{font-size:24rpx;color:#7d898e}
