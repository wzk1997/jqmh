<page-meta page-style="--wt-font-scale:{{wtFontScale||1}};--wt-entry-caption-lines:{{wtFontScale>1?2:1}};--wt-entry-title-bottom:{{wtFontScale>1?62:31}}rpx;"/>
<wxs module="media" src="../../../../../wxs/media.wxs"/>
<scenic-nav-bar title="吃住行" bind:layout="bindScenicLayout"/>
<view class="living-page {{wtDisplayMode==='enlarged'?'display-enlarged':''}}"><view class="v3-light-heading"><text>吃住行</text></view><view class="living-tabs"><button wx:for="{{['food','stay','travel']}}" wx:key="*this" data-tab="{{item}}" bindtap="bindServiceTab" class="{{serviceTab==item?'active':''}}">{{item=='food'?'美食':item=='stay'?'住宿':'出行'}}</button></view>
<view class="living-list"><view class="living-row {{item.phone?'living-with-phone':''}}" wx:for="{{merchants}}" wx:key="id" bindtap="url" data-url="{{item.path}}"><image class="living-cover" wx:if="{{item.pic}}" src="{{media.display(item.pic,mediaUrls)}}" mode="aspectFill"/><view class="living-copy"><text>{{item.title}}</text><text>{{item.desc}}</text><text wx:if="{{item.address}}" class="living-address"><text class="icon-location"/> {{item.address}}</text></view><text wx:if="{{item.demo}}" class="demo-tag">演示</text><text class="living-arrow icon-right"/><button wx:if="{{item.phone}}" class="living-call" catchtap="url" data-type="phone" data-url="{{item.phone}}" aria-label="拨打商家电话"><text class="icon-phone"/></button></view></view>
<view class="living-list" wx:if="{{serviceTab=='stay'}}"><button class="living-row {{item.phone?'living-with-phone':''}}" wx:for="{{items}}" wx:key="id" bindtap="url" data-url="{{item.path}}"><image class="living-cover" wx:if="{{item.pic}}" src="{{media.display(item.pic,mediaUrls)}}" mode="aspectFill"/><view wx:else class="living-placeholder"><text class="icon-home"></text></view><view class="living-copy"><text class="content-cut-two">{{item.title}}</text><text class="content-cut-two">{{item.desc||item.label}}</text><text>查看详情 <text class="icon-right"></text></text></view></button></view>

<view wx:if="{{loading}}" class="wt-state">正在加载…</view><view wx:elif="{{error}}" class="wt-state">暂时无法获取商家信息<button class="living-retry" bindtap="retry">重新加载</button></view><view wx:elif="{{!items.length&&!merchants.length}}" class="wt-state">更多地方好去处，敬请期待</view><button wx:if="{{partialError}}" class="living-retry" bindtap="retry">部分信息加载失败，点击重试</button><button wx:if="{{hasMore&&!loading}}" class="living-load-more" bindtap="loadMore">加载更多</button></view>
<reading-tools id="readingTools"/>
