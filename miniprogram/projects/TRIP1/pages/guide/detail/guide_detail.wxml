<wxs module="media" src="../../../../../wxs/media.wxs"/>
<wxs module="rich" src="../../../../../wxs/rich_text.wxs"/>
<scenic-nav-bar title="攻略详情" bind:layout="bindScenicLayout"/><view wx:if="{{isLoad===null}}" class="wt-state">该攻略暂不可查看，请返回选择其他内容。</view><view wx:elif="{{!isLoad}}" class="wt-state">正在加载攻略…</view><block wx:else><view class="travel-hero"><image wx:if="{{guide.GUIDE_OBJ.cover[0] && guide.GUIDE_OBJ.cover[0]!='/images/cover.gif'}}" class="travel-hero-image" src="{{media.display(guide.GUIDE_OBJ.cover[0],mediaUrls)}}" mode="aspectFill"/><view class="travel-hero-shade"/><view class="travel-hero-copy"><text class="travel-hero-title">{{guide.GUIDE_TITLE}}</text><text class="travel-hero-subtitle">{{guide.GUIDE_OBJ.desc||guide.GUIDE_CATE_NAME}}</text></view></view><view class="travel-body"><view wx:if="{{guide.GUIDE_DEMO}}" class="demo-notice">演示攻略 · 景点、路线与时长仅供界面预览</view><view class="travel-meta"><text wx:if="{{spots.length}}"><text class="icon-location"/> {{spots.length}} 个景点</text><text wx:if="{{guide.GUIDE_DURATION}}"><text class="icon-time"/> {{guide.GUIDE_DURATION}}</text><text wx:if="{{guide.GUIDE_VIEW_CNT}}"><text class="icon-attention"/> {{guide.GUIDE_VIEW_CNT}} 次浏览</text></view><view wx:if="{{introText}}" class="travel-description">{{introText}}</view><view wx:if="{{highlights.length}}" class="travel-section"><text class="travel-section-title">路线亮点</text><view class="travel-highlights"><view wx:for="{{highlights}}" wx:key="_id" class="travel-highlight"><image src="{{media.display(item.cover,mediaUrls)}}" mode="aspectFill"/><text>{{item.highlight||item.SPOT_TITLE}}</text></view></view></view><view wx:if="{{spots.length}}" class="travel-section"><text class="travel-section-title">行程路线</text><view class="travel-itinerary"><button wx:for="{{spots}}" wx:key="_id" class="travel-stop" bindtap="url" data-url="../../spot/detail/spot_detail?id={{item._id}}"><view class="travel-stop-dot">{{index+1}}</view><image wx:if="{{item.cover && item.cover!='/images/cover.gif'}}" src="{{media.display(item.cover,mediaUrls)}}" mode="aspectFill"/><view class="travel-stop-copy"><text>{{item.SPOT_TITLE}}</text><text>{{item.note||item.SPOT_OBJ.address||'查看景点详情'}}</text></view><text wx:if="{{item.duration}}" class="travel-stop-time">{{item.duration}}</text><text wx:else class="icon-right"/></button></view></view><view wx:if="{{guide.GUIDE_OBJ.detail.length}}" class="travel-section"><text class="travel-section-title">攻略介绍</text><block wx:for="{{guide.GUIDE_OBJ.detail}}" wx:key="index"><text wx:if="{{item.type==='text'}}" class="travel-text" style="{{rich.style(item)}}" user-select>{{item.val}}</text><image wx:elif="{{item.type==='img'}}" class="travel-content-image" src="{{media.display(item.val,mediaUrls)}}" mode="widthFix" bindtap="url" data-type="img" data-url="{{item.val}}"/></block></view><text class="travel-footnote">WeTravel · 山水相伴，自在出发</text></view><cmpt-detail mode="guide" doHome="{{false}}" doTop="{{false}}" doShare="{{false}}" doPoster="{{false}}" oid="{{guide._id}}" cate="{{guide.GUIDE_CATE_NAME}}" title="{{guide.GUIDE_TITLE}}" cover="{{guide.GUIDE_OBJ.cover[0]}}"/></block>
