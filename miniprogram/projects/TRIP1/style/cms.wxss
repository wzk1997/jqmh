page{background:#f8f6f5;color:#3f2923;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}.cms-page{padding:28rpx 28rpx calc(150rpx + env(safe-area-inset-bottom))}.cms-heading{font-size:40rpx;font-weight:600;margin:8rpx 0 12rpx}.cms-subtitle{font-size:25rpx;color:#827470;line-height:1.7;margin-bottom:28rpx}.cms-card{background:white;border:1rpx solid #eeeae9;border-radius:20rpx;padding:26rpx;margin-bottom:24rpx}.cms-row{display:flex;align-items:center;gap:24rpx}.cms-cover{width:132rpx;height:132rpx;flex-shrink:0;border-radius:14rpx;background:#f3eeed}.cms-cover-empty{display:flex;align-items:center;justify-content:center;color:#ac9792;font-size:44rpx}.cms-row-copy{flex:1;min-width:0;text-align:left}.cms-name{font-size:30rpx;font-weight:600;line-height:1.5;display:block}.cms-meta{color:#827774;font-size:23rpx;margin-top:12rpx;display:block;line-height:1.5}.cms-badge{padding:6rpx 12rpx;border-radius:8rpx;font-size:22rpx;white-space:nowrap;display:inline-block}.cms-badge-published{color:#a44736;background:#f5e8e4}.cms-badge-draft{color:#92651c;background:#fff2dd}.cms-badge-offline{color:#776c69;background:#f1efef}.cms-button{font-size:28rpx;min-height:88rpx;line-height:88rpx;border-radius:14rpx;border:0;margin:0;padding:0 24rpx;font-weight:500}.cms-button:after{border:0}.cms-primary{background:#a44736;color:white}.cms-secondary{background:#f2ecea;color:#a44736}.cms-danger{background:#fff0ee;color:#b14b42}.cms-link{background:transparent;color:#a44736}.cms-list-button{width:100%;padding:24rpx;background:white;line-height:normal;min-height:164rpx;margin-bottom:20rpx;border-radius:18rpx;color:inherit}.cms-list-button:after{border:1rpx solid #eeeae9}.cms-search{background:white;border:1rpx solid #ebe6e5;border-radius:16rpx;padding:0 22rpx;height:88rpx;display:flex;align-items:center;gap:14rpx;margin-bottom:18rpx}.cms-search-input{height:88rpx;flex:1;font-size:28rpx}.cms-tabs{display:flex;gap:12rpx;margin-bottom:24rpx;flex-wrap:wrap}.cms-tab{font-size:25rpx;background:white;color:#7c6e6a;line-height:76rpx;min-height:76rpx;padding:0 24rpx;margin:0;border-radius:38rpx}.cms-tab:after{border:0}.cms-tab-active{background:#a44736;color:white}.cms-bottom{position:fixed;bottom:0;left:0;right:0;padding:20rpx 28rpx calc(20rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.98);border-top:1rpx solid #ebe5e3;display:flex;gap:16rpx;z-index:60}.cms-bottom .cms-button{flex:1}.cms-label{font-size:28rpx;font-weight:500;display:block;margin-bottom:16rpx}.cms-field{margin-bottom:26rpx}.cms-input{background:#f9f7f7;min-height:88rpx;box-sizing:border-box;border:1rpx solid #ebe5e3;border-radius:12rpx;padding:20rpx;font-size:28rpx;width:100%;line-height:1.6}.cms-textarea{min-height:150rpx}.cms-section-title{font-size:32rpx;font-weight:600;margin:0 0 24rpx}.cms-hero{width:100%;height:360rpx;border-radius:20rpx;display:block;margin-bottom:24rpx}.cms-detail-text{font-size:28rpx;line-height:1.8;white-space:pre-wrap;word-break:break-all}.cms-photo-grid{display:flex;flex-wrap:wrap;gap:16rpx}.cms-photo{width:calc((100% - 32rpx)/3);height:180rpx;border-radius:12rpx}.cms-rule{border-top:1rpx solid #f1eeed;margin:22rpx 0}.cms-fact{display:flex;gap:24rpx;font-size:27rpx;line-height:1.8;margin:14rpx 0}.cms-fact-label{color:#8b7e7a;min-width:112rpx}.cms-body-image{width:100%;border-radius:14rpx;margin:20rpx 0}.cms-field-error{color:#b14b42;font-size:25rpx;margin-bottom:18rpx}.cms-pill{color:#a44736;font-size:24rpx;background:#f4ecea;padding:10rpx 18rpx;border-radius:12rpx;margin:8rpx;display:inline-block}.cms-checks{max-height:400rpx;overflow:auto}.cms-check{display:flex;align-items:center;gap:16rpx;min-height:88rpx;font-size:27rpx}.cms-upload-hint{color:#8b7e7a;font-size:23rpx;line-height:1.7}
