<wxs module="media" src="../../../../../wxs/media.wxs"/>
<scenic-nav-bar wx:if="{{!scenes.length}}" title="全景漫游" bind:layout="bindScenicLayout"/><view wx:if="{{!scenes.length}}" class="panorama-empty"><text class="icon-full"/><text>{{loading?'正在加载全景资源…':error?'暂时无法打开全景资源':'暂无已发布的全景资源'}}</text><text wx:if="{{!loading}}">{{error?'请稍后重试':'景区发布后将在这里展示'}}</text><button wx:if="{{error&&!loading}}" bindtap="loadResources">重新加载</button></view><view wx:else class="panorama-page"><view class="panorama-stage"><image src="{{media.display(scenes[current].pic,mediaUrls)}}" mode="aspectFill"/><view class="panorama-shade"></view><scenic-nav-bar mode="immersive" title="全景漫游" overlay bind:layout="bindScenicLayout"/><view class="panorama-caption"><text>{{scenes[current].title}}</text></view><button class="panorama-play" bindtap="bindPlay" disabled="{{scenes.length<2}}" aria-label="{{playing?'暂停轮播':'播放风景轮播'}}">{{playing?'Ⅱ':'▶'}}</button><button class="panorama-enlarge" bindtap="bindPreview">{{scenes[current].type==='url'?'进入全景':'查看大图'}} <text class="icon-full"></text></button></view><view class="panorama-bottom"><scroll-view scroll-x class="panorama-thumbs"><button wx:for="{{scenes}}" wx:key="id" bindtap="bindSelect" data-index="{{index}}" class="{{current==index?'selected':''}}"><image src="{{media.display(item.pic,mediaUrls)}}" mode="aspectFill"/><text>{{item.title}}</text></button></scroll-view><button wx:if="{{hasMore}}" class="panorama-load" bindtap="loadMore" loading="{{loading}}" disabled="{{loading}}">{{error?'重试加载更多':'加载更多场景'}}</button><view class="panorama-actions"><button bindtap="bindPrevious">上一景</button><button class="play" bindtap="bindPlay" disabled="{{scenes.length<2}}">{{playing?'Ⅱ':'▶'}}</button><button bindtap="bindNext">下一景</button></view><text class="panorama-note">景区影像 · 轻触探索更多风景</text></view></view>
