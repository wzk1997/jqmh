<page-meta page-style="--wt-font-scale:{{wtFontScale||1}};--wt-entry-caption-lines:{{wtFontScale>1?2:1}};--wt-entry-title-bottom:{{wtFontScale>1?62:31}}rpx;"/>
<wxs module="media" src="../../../../../wxs/media.wxs"/>
<scenic-nav-bar title="景点详情" bind:layout="bindScenicLayout"/><view wx:if="{{isLoad===null}}" class="wt-state"><text>该景点暂不可查看</text><button bindtap="url" data-url="../../album/index/album_index" data-type="relaunch">返回园区攻略</button></view><view wx:elif="{{!isLoad}}" class="wt-state">正在加载景点详情…</view><block wx:else><view class="travel-hero {{wtDisplayMode==='enlarged'?'display-enlarged':''}}"><swiper wx:if="{{photos.length}}" class="travel-hero-image" bindchange="photoChange" circular><swiper-item wx:for="{{photos}}" wx:key="*this"><image class="travel-hero-image" src="{{media.display(item,mediaUrls)}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item}}"/></swiper-item></swiper><text wx:if="{{photos.length}}" class="travel-count"><text class="icon-location"/> {{photoIndex+1}}/{{photos.length}}</text></view><view class="travel-body {{wtDisplayMode==='enlarged'?'display-enlarged':''}}"><view class="travel-header-row"><text class="travel-title" user-select>{{product.PRODUCT_TITLE}}</text><cmpt-detail doFav="{{false}}" mode="compact" doHome="{{false}}" doTop="{{false}}" doShare="{{false}}" doPoster="{{false}}" oid="{{product._id}}" cate="{{product.PRODUCT_CATE_NAME}}" title="{{product.PRODUCT_TITLE}}"/></view><text class="travel-description">{{product.PRODUCT_OBJ.subtitle||product.PRODUCT_CATE_NAME}}</text><view wx:if="{{product.PRODUCT_DEMO}}" class="demo-notice">演示景点 · 图文与游览信息仅供页面预览</view><view class="travel-meta"><text wx:if="{{product.PRODUCT_OBJ.distance}}"><text class="icon-location"/> {{product.PRODUCT_OBJ.distance}}</text><text wx:if="{{product.PRODUCT_OBJ.duration}}"><text class="icon-time"/> {{product.PRODUCT_OBJ.duration}}</text><text wx:if="{{product.PRODUCT_OBJ.bestTime}}">{{product.PRODUCT_OBJ.bestTime}}</text><text wx:if="{{product.PRODUCT_OBJ.time&&!product.PRODUCT_OBJ.duration}}"><text class="icon-time"/> {{product.PRODUCT_OBJ.time}}</text><text>免费开放</text></view><view class="travel-tabs"><button class="travel-tab {{detailTab==='intro'?'active':''}}" bindtap="selectTab" data-tab="intro">景点介绍</button><button wx:if="{{hasTips}}" class="travel-tab {{detailTab==='tips'?'active':''}}" bindtap="selectTab" data-tab="tips">游览贴士</button><button class="travel-tab {{detailTab==='photos'?'active':''}}" bindtap="selectTab" data-tab="photos">精选照片</button></view><block wx:if="{{detailTab==='intro'}}"><text class="travel-text" user-select>{{product.PRODUCT_OBJ.desc||'景点介绍正在完善中'}}</text><image wx:if="{{photos[0]}}" class="travel-content-image" src="{{media.display(photos[0],mediaUrls)}}" mode="widthFix" bindtap="previewPhoto" data-url="{{photos[0]}}"/><view wx:if="{{product.PRODUCT_OBJ.address}}" class="travel-tip"><text class="travel-tip-title"><text class="icon-location"/> 景点位置</text><text user-select>{{product.PRODUCT_OBJ.address}}</text></view></block><block wx:elif="{{detailTab==='tips'&&hasTips}}"><view wx:if="{{product.PRODUCT_OBJ.traffic}}" class="travel-tip"><text class="travel-tip-title">交通指南</text><text user-select>{{product.PRODUCT_OBJ.traffic}}</text></view><view wx:if="{{product.PRODUCT_OBJ.other}}" class="travel-tip"><text class="travel-tip-title">游览贴士</text><text user-select>{{product.PRODUCT_OBJ.other}}</text></view></block><view wx:else class="travel-gallery"><image wx:for="{{photos}}" wx:key="*this" src="{{media.display(item,mediaUrls)}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item}}"/><view wx:if="{{!photos.length}}" class="wt-state">暂无景点照片</view></view><view class="travel-bottom-space"/></view></block>
<reading-tools id="readingTools"/>
