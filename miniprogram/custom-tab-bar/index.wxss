.travel-tab-bar{position:fixed;left:0;right:0;bottom:0;z-index:1000;background:#fff;border-radius:28rpx 28rpx 0 0;box-shadow:0 -4rpx 22rpx rgba(39,94,81,.045);padding-bottom:env(safe-area-inset-bottom);overflow:hidden}.tab-mountains{position:absolute;left:0;bottom:0;width:100%;height:130rpx;opacity:.65;pointer-events:none}.travel-tabs{position:relative;height:128rpx;display:flex;align-items:center;padding:4rpx 10rpx;box-sizing:border-box}.travel-tab{flex:1;min-width:0;margin:0;padding:0;background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rpx;height:120rpx;line-height:1.4;color:#79809c;font-size:24rpx;border-radius:18rpx}.travel-tab:after{border:0}.travel-tab-icon{width:70rpx;height:70rpx;display:block}.travel-tab.selected{color:#087f70;font-weight:600}.travel-tab.selected .travel-tab-icon{width:78rpx;height:78rpx}.travel-tab:active{background:rgba(226,246,238,.45)}
