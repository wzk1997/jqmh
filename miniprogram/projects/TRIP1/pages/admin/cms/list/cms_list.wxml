<wxs module="media" src="../../../../../../wxs/media.wxs"/>
<scenic-nav-bar title="{{title}}"/><view wx:if="{{isAdmin}}" class="cms-page"><view class="cms-heading">{{title}}</view><view class="cms-subtitle">维护内容，让游客看见园区的美好</view><view class="cms-search"><text class="icon-search"/><input class="cms-search-input" value="{{search}}" bindinput="inputSearch" bindconfirm="search" confirm-type="search" placeholder="搜索名称或标题" maxlength="50"/><button class="cms-button cms-link" bindtap="search">搜索</button></view><picker wx:if="{{module==='news'||module==='album'||module==='product'}}" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="pickCategory"><view class="cms-search">{{categories[categoryIndex].name}} <text class="icon-unfold"/></view></picker><view wx:if="{{module==='merchant'}}" class="cms-tabs"><button wx:for="{{merchantTabs}}" wx:key="id" class="cms-tab {{category===item.id?'cms-tab-active':''}}" bindtap="filter" data-field="category" data-id="{{item.id}}">{{item.name}}</button></view><view class="cms-tabs"><button wx:for="{{states}}" wx:key="id" class="cms-tab {{state===item.id?'cms-tab-active':''}}" bindtap="filter" data-field="state" data-id="{{item.id}}">{{item.name}}</button></view><cms-state loading="{{loading && !records.length}}" error="{{error}}" empty="{{!loading && !error && !records.length}}" bind:retry="load"/><view wx:for="{{records}}" wx:key="id" class="cms-list-item"><button class="cms-list-button cms-row" bindtap="detail" data-id="{{item.id}}"><image wx:if="{{item.cover}}" class="cms-cover" src="{{media.display(item.cover,mediaUrls)}}" mode="aspectFill"/><view wx:else class="cms-cover cms-cover-empty"><text class="icon-pic"/></view><view class="cms-row-copy"><text class="cms-name">{{item.name}}</text><text class="cms-meta">{{item.categoryName}} {{item.date}}</text><text wx:if="{{item.hasDraft}}" class="cms-meta">有未发布修改</text></view><text class="cms-badge cms-badge-{{item.state}}">{{item.stateLabel}}</text></button><button wx:if="{{module==='category' && canDelete}}" class="cms-button cms-danger cms-category-delete" catchtap="removeCategory" data-id="{{item.id}}" disabled="{{deleting}}" aria-label="删除分类{{item.name}}">删除</button></view><text wx:if="{{deleteError}}" class="cms-field-error">{{deleteError}}</text><view wx:if="{{hasMore && !error}}" class="cms-meta">{{loading?'正在加载…':'上拉加载更多'}}</view><view class="cms-bottom"><button wx:if="{{module==='news'||module==='album'||module==='product'}}" class="cms-button cms-secondary" bindtap="categories">分类管理</button><button wx:if="{{canWrite}}" class="cms-button cms-primary" bindtap="add">＋ 新增{{module==='category'?'分类':'内容'}}</button></view></view>
