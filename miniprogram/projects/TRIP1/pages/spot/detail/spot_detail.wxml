<wxs module="media" src="../../../../../wxs/media.wxs"/>
<scenic-nav-bar title="景点详情" bind:layout="bindScenicLayout"/><view wx:if="{{isLoad===null}}" class="wt-state"><text>该景点暂不可查看</text><button bindtap="url" data-url="../index/spot_index" data-type="relaunch">返回景区导览</button></view><view wx:elif="{{!isLoad}}" class="wt-state">正在加载景点详情…</view><block wx:else><view class="travel-hero"><swiper wx:if="{{photos.length}}" class="travel-hero-image" bindchange="photoChange" circular><swiper-item wx:for="{{photos}}" wx:key="*this"><image class="travel-hero-image" src="{{media.display(item,mediaUrls)}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item}}"/></swiper-item></swiper><text wx:if="{{photos.length}}" class="travel-count"><text class="icon-location"/> {{photoIndex+1}}/{{photos.length}}</text></view><view class="travel-body"><view class="travel-header-row"><text class="travel-title" user-select>{{spot.SPOT_TITLE}}</text><cmpt-detail mode="compact" doHome="{{false}}" doTop="{{false}}" doShare="{{false}}" doPoster="{{false}}" oid="{{spot._id}}" cate="{{spot.SPOT_CATE_NAME}}" title="{{spot.SPOT_TITLE}}"/></view><text class="travel-description">{{spot.SPOT_OBJ.subtitle||spot.SPOT_CATE_NAME}}</text><view wx:if="{{spot.SPOT_DEMO}}" class="demo-notice">演示景点 · 图文与游览信息仅供页面预览</view><view class="travel-meta"><text wx:if="{{spot.SPOT_OBJ.distance}}"><text class="icon-location"/> {{spot.SPOT_OBJ.distance}}</text><text wx:if="{{spot.SPOT_OBJ.duration}}"><text class="icon-time"/> {{spot.SPOT_OBJ.duration}}</text><text wx:if="{{spot.SPOT_OBJ.bestTime}}">{{spot.SPOT_OBJ.bestTime}}</text><text wx:if="{{spot.SPOT_OBJ.time&&!spot.SPOT_OBJ.duration}}"><text class="icon-time"/> {{spot.SPOT_OBJ.time}}</text><text>免费开放</text></view><view class="travel-tabs"><button class="travel-tab {{detailTab==='intro'?'active':''}}" bindtap="selectTab" data-tab="intro">景点介绍</button><button class="travel-tab {{detailTab==='tips'?'active':''}}" bindtap="selectTab" data-tab="tips">游览贴士</button><button class="travel-tab {{detailTab==='photos'?'active':''}}" bindtap="selectTab" data-tab="photos">精选照片</button></view><block wx:if="{{detailTab==='intro'}}"><text class="travel-text" user-select>{{spot.SPOT_OBJ.desc||'景点介绍正在完善中'}}</text><image wx:if="{{photos[0]}}" class="travel-content-image" src="{{media.display(photos[0],mediaUrls)}}" mode="widthFix" bindtap="previewPhoto" data-url="{{photos[0]}}"/><view wx:if="{{spot.SPOT_OBJ.address}}" class="travel-tip"><text class="travel-tip-title"><text class="icon-location"/> 景点位置</text><text user-select>{{spot.SPOT_OBJ.address}}</text></view></block><block wx:elif="{{detailTab==='tips'}}"><view wx:if="{{spot.SPOT_OBJ.traffic}}" class="travel-tip"><text class="travel-tip-title">交通指南</text><text user-select>{{spot.SPOT_OBJ.traffic}}</text></view><view wx:if="{{spot.SPOT_OBJ.other}}" class="travel-tip"><text class="travel-tip-title">游览贴士</text><text user-select>{{spot.SPOT_OBJ.other}}</text></view><view wx:if="{{!spot.SPOT_OBJ.traffic&&!spot.SPOT_OBJ.other}}" class="wt-state">游览贴士正在完善中</view></block><view wx:else class="travel-gallery"><image wx:for="{{photos}}" wx:key="*this" src="{{media.display(item,mediaUrls)}}" mode="aspectFill" bindtap="previewPhoto" data-url="{{item}}"/><view wx:if="{{!photos.length}}" class="wt-state">暂无景点照片</view></view><view class="travel-bottom-space"/></view></block>
