@import "../../../style/design_v3.wxss";
page{background:#f8f2f1;color:#3b2620}.guide-page{padding-bottom:calc(140rpx + env(safe-area-inset-bottom))}.guide-hero{height:370rpx;position:relative}.guide-hero-image,.guide-hero-shade{position:absolute;inset:0;width:100%;height:100%}.guide-hero-shade{background:linear-gradient(180deg,rgba(41,24,20,.1),rgba(38,22,18,.5))}.guide-hero-copy{position:absolute;left:32rpx;right:32rpx;top:75rpx;text-align:center;color:white;display:flex;flex-direction:column;gap:18rpx}.guide-hero-title{font-size:calc(45rpx * var(--wt-font-scale, 1));font-weight:600;letter-spacing:2rpx}.guide-hero-subtitle{font-size:calc(25rpx * var(--wt-font-scale, 1));letter-spacing:1rpx}.guide-sheet{position:relative;margin-top:-12rpx;background:#fff;border-radius:30rpx 30rpx 0 0;padding:28rpx}.guide-entries{display:flex;justify-content:space-between;margin-bottom:26rpx}.guide-entry{padding:0;margin:0;width:50%;background:transparent;font-size:calc(24rpx * var(--wt-font-scale, 1));display:flex;flex-direction:column;align-items:center;gap:15rpx;min-height:130rpx;color:#493834}.guide-entry:after{border:0}.guide-entry-icon{width:88rpx;height:88rpx;border-radius:26rpx;display:flex;align-items:center;justify-content:center;font-size:42rpx}.guide-entry-green{background:#f3e4e0;color:#553229}.guide-entry-orange{background:#fff2df;color:#e59620}.guide-sort{display:flex;justify-content:space-between;border-bottom:1rpx solid #f1eeed;margin-bottom:8rpx}.guide-sort-button{background:transparent;margin:0;padding:0 8rpx;min-height:88rpx;line-height:88rpx;font-size:calc(27rpx * var(--wt-font-scale, 1));color:#7c8991;border-radius:0;position:relative}.guide-sort-button:after{border:0}.guide-sort-button.active{color:#a44736;font-weight:600}.guide-sort-button.active:before{content:'';position:absolute;left:20%;right:20%;height:4rpx;background:#a44736;bottom:0;border-radius:4rpx}.guide-row{display:flex;align-items:center;gap:22rpx;width:100%;padding:25rpx 0;margin:0;background:white;min-height:180rpx;text-align:left;border-radius:0;line-height:normal;color:inherit}.guide-row:after{border:0;border-bottom:1rpx solid #f2eeed;border-radius:0}.guide-cover{width:170rpx;height:148rpx;border-radius:15rpx;flex-shrink:0}.guide-placeholder{background:#f1e8e5;color:#b6978f;display:flex;align-items:center;justify-content:center;font-size:42rpx}.guide-row-copy{flex:1;min-width:0}.guide-row-title{display:block;font-size:calc(30rpx * var(--wt-font-scale, 1));font-weight:600;line-height:1.5}.guide-row-desc{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:calc(24rpx * var(--wt-font-scale, 1));line-height:1.65;color:#918582;margin-top:10rpx}.guide-row-meta{display:flex;gap:18rpx;flex-wrap:wrap;font-size:calc(21rpx * var(--wt-font-scale, 1));color:#8b7e7b;margin-top:12rpx}.guide-row-arrow{background:#f8f3f2;color:#553229;width:44rpx;height:44rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:23rpx}.guide-state{padding:50rpx 20rpx;text-align:center;color:#948783;font-size:calc(27rpx * var(--wt-font-scale, 1))}.guide-state button,.guide-category button{background:#f4ebe9;color:#58342a;font-size:calc(26rpx * var(--wt-font-scale, 1));min-height:88rpx;border-radius:14rpx;margin-top:16rpx}.guide-category{display:flex;align-items:center;justify-content:space-between;color:#795a52;font-size:calc(25rpx * var(--wt-font-scale, 1))}.guide-category button{margin:12rpx 0;line-height:70rpx;min-height:70rpx}

.guide-hero{height:280rpx}.guide-hero-copy{top:84rpx}.guide-hero-title{font-family:STKaiti,KaiTi,STSong,serif;font-size:calc(46rpx * var(--wt-font-scale, 1))}.guide-sheet{padding:24rpx 28rpx}.guide-entries{margin-bottom:12rpx}.guide-entry{gap:12rpx;min-height:122rpx}.guide-entry-icon{width:82rpx;height:82rpx}.guide-sort{width:100%;margin-bottom:0;gap:0}.guide-sort-button{flex:1;min-width:0;text-align:center;font-size:calc(27rpx * var(--wt-font-scale, 1));line-height:88rpx;padding:0 4rpx}.guide-sort-button.active:before{left:34%;right:34%}.guide-cover-wrap{position:relative;flex-shrink:0;width:170rpx;height:148rpx}.guide-rank{position:absolute;top:0;left:0;padding:5rpx 12rpx;background:#a44736;color:#fff;font-size:20rpx;line-height:1.4;border-radius:15rpx 0 12rpx 0}.guide-row{gap:20rpx;padding:22rpx 0;min-height:178rpx}.guide-row-desc{-webkit-line-clamp:1}.guide-row-meta{gap:14rpx;font-size:calc(22rpx * var(--wt-font-scale, 1))}.guide-row-arrow{flex-shrink:0}
.guide-entry.active{color:#a44736;font-weight:600}.guide-entry.active .guide-entry-icon{box-shadow:0 0 0 4rpx rgba(86,51,41,.14)}.guide-section-heading{min-height:88rpx;border-bottom:1rpx solid #f1eeed;display:flex;align-items:center;justify-content:space-between;gap:24rpx}.guide-section-heading>text:first-child{font-size:calc(29rpx * var(--wt-font-scale, 1));font-weight:600;color:#3b2620}.guide-section-heading>text:last-child{font-size:calc(23rpx * var(--wt-font-scale, 1));color:#918582;text-align:right}
.guide-categories{width:100%;white-space:nowrap;border-bottom:1rpx solid #f1eeed}.guide-category-list{display:inline-flex;gap:16rpx;padding:8rpx 0 18rpx;min-width:100%}.guide-category-button{flex-shrink:0;margin:0;padding:0 28rpx;min-width:112rpx;min-height:64rpx;line-height:64rpx;border-radius:8rpx;background:#f6f2f1;color:#736460;font-size:calc(25rpx * var(--wt-font-scale, 1))}.guide-category-button:after{border:0}.guide-category-button.active{background:#a44736;color:#fff;font-weight:600}
