<page-meta page-style="--wt-font-scale:{{wtFontScale||1}};--wt-entry-caption-lines:{{wtFontScale>1?2:1}};--wt-entry-title-bottom:{{wtFontScale>1?62:31}}rpx;"/>
<wxs module="media" src="../../../../../wxs/media.wxs"/>
<scenic-nav-bar title="{{guideScope?'搜索攻略':''}}" bind:layout="bindScenicLayout"/>
<view class="v3-page {{wtDisplayMode==='enlarged'?'display-enlarged':''}} {{guideScope?'guide-search-page':''}}"><view wx:if="{{!guideScope}}" class="v3-light-heading"><text>发现小镇去处、美食与生活故事</text></view><view class="portal-search-input"><text class="icon-search"></text><input value="{{query}}" bindinput="bindInput" bindconfirm="bindSearch" confirm-type="search" maxlength="30" placeholder="{{guideScope?'搜索攻略、景点、游玩贴士':'搜索景点、攻略、资讯与服务'}}" aria-label="搜索景点、攻略、资讯与服务"/><button bindtap="bindSearch">搜索</button><button wx:if="{{guideScope}}" class="guide-cancel" bindtap="cancel">取消</button></view><view class="search-types"><button wx:for="{{types}}" wx:key="id" bindtap="bindType" data-type="{{item.id}}" class="{{activeType==item.id?'active':''}}">{{item.title}}</button></view><view class="wt-state" wx:if="{{loading}}">正在搜索…</view><view wx:elif="{{searched&&!visible.length}}" class="wt-state">{{failures.length?'部分内容暂时无法获取，请重试':'没有找到相关内容，试试其他关键词'}}</view><view wx:elif="{{!searched}}" class="search-intro"><text class="icon-discover"></text><text>从一个关键词开始你的旅程</text></view><button wx:for="{{visible}}" wx:key="key" bindtap="url" data-url="{{item.path}}" class="search-result"><image wx:if="{{item.pic}}" src="{{media.display(item.pic,mediaUrls)}}" mode="aspectFill"/><view><text class="search-result-kind">{{item.type=='product'?'景点':item.type=='album'?'攻略':item.type=='service'?'服务':guideScope?'游玩贴士':'资讯'}}</text><text class="content-cut-two">{{item.title}}</text><text class="content-cut-two">{{item.desc}}</text></view><text class="icon-right"></text></button><view wx:if="{{failures.length&&visible.length}}" class="search-partial">部分分类暂时无法获取，可重新搜索</view></view>
<reading-tools id="readingTools"/>
