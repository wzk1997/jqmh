@import "../../../style/design_v3.wxss";
page{background:#faf8f8}.living-tabs{display:flex;margin:0 26rpx 15rpx;background:#f2edec;border-radius:50rpx;padding:5rpx}.living-tabs button{flex:1;border-radius:45rpx;background:transparent;font-size:25rpx;color:#938683;line-height:75rpx}.living-tabs .active{background:#a44736;color:white}.living-list{margin:0 26rpx;padding:0 22rpx;background:white;border-radius:20rpx}.living-row{display:flex;align-items:center;text-align:left;gap:22rpx;background:white;padding:25rpx 0;border-bottom:1rpx solid #f2efee}.living-row>image,.living-placeholder{width:192rpx;height:145rpx;border-radius:14rpx;flex-shrink:0}.living-placeholder{background:#f3ecea;color:#987a72;font-size:45rpx;display:flex;align-items:center;justify-content:center}.living-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:12rpx;line-height:1.45}.living-copy>text:first-child{font-size:29rpx;font-weight:600;color:#3d2b26}.living-copy>text:nth-child(2){font-size:23rpx;color:#9b8e8b}.living-copy>text:last-child{font-size:21rpx;color:#936255}.living-travel{margin:0 26rpx}.living-retry{font-size:24rpx;color:#a44736;background:#f6efed}

.living-call{width:88rpx;min-width:88rpx;height:88rpx;border-radius:50%;color:#fff;background:#a44736;padding:0;line-height:88rpx;font-size:34rpx}.living-call:after{border:0}
.living-load-more{margin:26rpx;min-height:88rpx;line-height:88rpx;background:#f5efed;color:#a44736;font-size:26rpx;border-radius:44rpx}.living-retry{margin:20rpx 26rpx;min-height:88rpx;line-height:1.5;padding:22rpx;font-size:25rpx;border-radius:20rpx}.living-call{flex-shrink:0}

/* Match the guide's clean image-and-copy list panel. */
.living-page{padding-top:12rpx}.living-tabs{background:transparent;gap:14rpx;padding:0;margin:0 26rpx 24rpx}.living-tabs button{background:#f3eeed;color:#5d4842;min-height:80rpx;line-height:80rpx;font-size:25rpx}.living-tabs .active{background:#a44736;color:#fff}.living-list{padding:0 24rpx;border-radius:28rpx;background:#fff}.living-row{width:100%;gap:20rpx;line-height:1.5;padding:24rpx 0}.living-row:last-child{border-bottom:0}.living-row>image,.living-placeholder{width:172rpx;height:144rpx;border-radius:16rpx}.living-copy>text:first-child{font-size:28rpx;color:#382c28}.living-copy>text:nth-child(2){font-size:23rpx;color:#756662;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.living-copy>text:last-child{font-size:21rpx;color:#6f5852}.living-arrow{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:48rpx;height:48rpx;border-radius:50%;background:#f4e9e6;color:#a44736;font-size:24rpx}.living-address{line-height:1.5}.demo-tag{font-size:20rpx;color:#6f5852;flex-shrink:0}.living-call{width:80rpx;min-width:80rpx;height:80rpx;line-height:80rpx;font-size:30rpx}
