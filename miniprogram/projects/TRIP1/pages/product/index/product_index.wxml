<wxs module="media" src="../../../../../wxs/media.wxs"/>
<scenic-nav-bar bind:layout="bindScenicLayout" title="景区导览"/>
<view wx:if="{{mapMode}}" class="guide-map-page" style="height:calc(100vh - {{uiChrome.height}}px - 128rpx - env(safe-area-inset-bottom))"><view class="guide-map-canvas" style="transform:scale({{mapScale}})"><image src="{{media.display(mapImage,mediaUrls)}}" mode="aspectFill"/><button wx:for="{{guideItems}}" wx:key="id" class="guide-pin {{selected.id==item.id?'selected':''}}" style="left:{{item.x}}%;top:{{item.y}}%" bindtap="bindPin" data-id="{{item.id}}"><text class="icon-location"></text><text>{{item.title}}</text></button></view><view class="guide-map-top"><button class="guide-map-search" bindtap="bindMapMode"><text class="icon-list"></text> 查看全部景点</button><text class="guide-map-note">导览示意 · 点位仅作展示，不代表真实位置</text></view><view class="guide-map-tools"><button bindtap="bindZoom" aria-label="缩放导览">{{mapScale==1?'+':'−'}}</button><button bindtap="bindReset" aria-label="复位导览"><text class="icon-location"></text></button></view>
<view wx:if="{{selected}}" class="guide-map-sheet"><view class="guide-map-detail"><image wx:if="{{selected.pic}}" src="{{media.display(selected.pic,mediaUrls)}}" mode="aspectFill"/><view wx:else class="guide-map-placeholder"><text class="icon-discover"></text></view><view><text>{{selected.title}}</text><text class="guide-map-label">{{selected.label}}</text><text class="content-cut-two">{{selected.desc||'发现风景，了解景点故事'}}</text></view><button class="guide-sheet-close" bindtap="bindMapMode" aria-label="查看景点列表"><text class="icon-list"></text></button></view><view class="guide-map-actions"><button bindtap="url" data-url="{{selected.path}}">详情</button><button bindtap="url" data-url="../../experience/ar/ar_index">AR 导航预览</button></view></view>
<view wx:else class="guide-service-sheet"><text>景点信息正在准备中</text><button bindtap="bindMapMode">查看景点列表</button><button bindtap="url" data-url="../../experience/ar/ar_index">AR 导航预览</button></view></view><view hidden="{{mapMode}}"><button class="guide-mode-button" bindtap="bindMapMode">切换示意导览</button><view wx:if="{{!_params}}" class="wt-state">正在加载景区导览…</view>
<block wx:else>
  <cmpt-comm-list topOffset="{{uiChrome.height}}" heading="景区导览" headingSubtitle="免费开放 · 浏览景点信息" headerHeight="160" bottomInset="{{uiChrome.tabInset}}" type="product-list" showSearch="{{false}}" _params="{{_params}}" route="product/list" topBottom="120" bind:list="bindCommListCmpt">
    <view class="product-list"><button class="item wt-card-button" wx:for="{{dataList.list}}" wx:key="_id" bindtap="url" data-url="../detail/product_detail?id={{item._id}}">
      <image wx:if="{{item.PRODUCT_OBJ.cover[0] && item.PRODUCT_OBJ.cover[0]!='/images/cover.gif'}}" class="guide-image" mode="aspectFill" lazy-load src="{{media.display(item.PRODUCT_OBJ.cover[0],mediaUrls)}}" /><view wx:else class="guide-image guide-empty"><text class="icon-location"></text><text>景点介绍</text></view>
      <view class="right"><text class="category">{{item.PRODUCT_CATE_NAME}}</text><view class="line1 content-cut-two">{{item.PRODUCT_TITLE}}</view><view class="line3 content-cut-two">{{item.PRODUCT_OBJ.desc}}</view><view class="guide-meta"><text class="free-label">免费开放</text><text>查看详情 <text class="icon-right"></text></text></view></view>
    </button></view>
    <import src="../../../../../tpls/public/list_load_tpl.wxml" /><template is="listLoadTpl" data="{{skin:'load-project',dataList,noHint:'暂无景点信息'}}" />
  </cmpt-comm-list>
  <block wx:if="{{skin.IS_SUB}}"><import src="../../tpls/menu_tpl.wxml" /><template is="menuTpl" data="{{curMenu:'product_index',skin,returnHome:false}}" /></block>
</block>
</view>
