/* WeTravel UI 2.0: shared across all project pages and UI components. */
page {
  --wt-brand: #a44736;
  --wt-brand-soft: #f4e6de;
  --wt-ink: #382c28;
  --wt-muted: #78675f;
  --wt-background: #faf7f2;
  --wt-surface: #ffffff;
  --wt-border: #e9dad0;
  --wt-radius-card: 24rpx;
  --wt-radius-small: 16rpx;
  --wt-space-page: 32rpx;
  --wt-space-section: 48rpx;
  --wt-font-small: calc(24rpx * var(--wt-font-scale, 1));
  --wt-font-body: calc(28rpx * var(--wt-font-scale, 1));
  --wt-font-title: calc(36rpx * var(--wt-font-scale, 1));
  /* Align existing utility classes with the same brand and text palette. */
  --projectColor: #a44736;
  --projectColorLight: #f4e6de;
  --green: #a44736;
  --darkgreen: #a44736;
  --greenLight: #f4e6de;
  --grey: #78675f;
  --darkGray: #78675f;
  --black: #382c28;
  --ghostWhite: #faf7f2;
  background: var(--wt-background);
  color: var(--wt-ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}
