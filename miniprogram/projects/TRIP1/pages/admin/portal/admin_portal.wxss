@import "../../../style/cms.wxss";
.portal-edit-slide{border-top:1rpx solid #e4ece8;padding-top:24rpx;margin-top:24rpx}.portal-edit-image{width:100%;height:300rpx;border-radius:18rpx;display:block;margin-bottom:20rpx}.portal-edit-actions{display:flex;gap:12rpx;margin-top:20rpx;flex-wrap:wrap}.portal-edit-actions button{font-size:24rpx;min-height:80rpx;line-height:80rpx;flex:1;min-width:120rpx;padding:0 12rpx}.portal-choice-row{display:flex;align-items:center;gap:20rpx;text-align:left;background:white;padding:20rpx 0;font-size:28rpx;line-height:1.5;width:100%;border-bottom:1rpx solid #edf1ee}.portal-choice-row image{width:110rpx;height:100rpx;border-radius:12rpx;flex-shrink:0}.portal-choice-types{display:flex;gap:12rpx;flex-wrap:wrap;margin:20rpx 0}.portal-choice-types button{font-size:24rpx;line-height:72rpx;border-radius:36rpx;padding:0 24rpx;margin:0;background:#edf5f2;color:#146c60}.portal-choice-types .active{background:#146c60;color:white}.portal-reference{overflow-wrap:anywhere;font-size:24rpx;color:#738183;margin:12rpx 0}.portal-enabled{display:flex;align-items:center;justify-content:space-between;margin-top:20rpx}
