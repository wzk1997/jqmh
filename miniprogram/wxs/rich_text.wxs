function style(node) {
    var format = node && node.format ? node.format : {};
    var value = '';
    if (format.bold === true) value += 'font-weight:600;';
    if (format.italic === true) value += 'font-style:italic;';
    if (format.underline === true) value += 'text-decoration:underline;';
    if (format.align === 'left' || format.align === 'center' || format.align === 'right') value += 'text-align:' + format.align + ';';
    return value;
}
module.exports = { style: style };
