@import "../../../style/skin.wxss";
.product-list { padding: 24rpx 32rpx 0; }
.product-list .item { display: flex; width: 100%; padding: 24rpx; margin-bottom: 20rpx; background: white; border-radius: 24rpx; }
.guide-image { width: 190rpx; height: 224rpx; border-radius: 16rpx; flex-shrink: 0; }
.product-list .right { flex: 1; min-width: 0; margin-left: 24rpx; }
.product-list .category { display: block; color: var(--wt-brand); font-size: 22rpx; margin-bottom: 10rpx; }
.product-list .line1 { color: var(--wt-ink); font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.product-list .line3 { color: var(--wt-muted); font-size: 25rpx; line-height: 1.7; margin-top: 12rpx; }
.guide-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; font-size: 22rpx; color: var(--wt-muted); }
.free-label { padding: 6rpx 10rpx; background: var(--wt-brand-soft); color: var(--wt-brand); border-radius: 8rpx; }

.guide-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--wt-brand-soft); color: var(--wt-brand); font-size: 23rpx; }
.guide-empty > text:first-child { font-size: 56rpx; margin-bottom: 16rpx; }

.guide-map-page{height:calc(100vh - 128rpx - env(safe-area-inset-bottom));position:relative;overflow:hidden;background:#e7f1df}
.guide-map-canvas{position:absolute;inset:0;width:100%;height:100%;overflow:hidden}
.guide-map-content{position:relative;width:100%;height:100%}
.guide-map-content>image{position:absolute;inset:0;width:100%;height:100%}
.guide-map-top{position:absolute;top:24rpx;left:26rpx;right:26rpx;pointer-events:none}
.guide-map-note{display:block;background:rgba(255,255,255,.78);border-radius:15rpx;padding:8rpx 15rpx;font-size:19rpx;color:#728571;width:fit-content}
.guide-pin{position:absolute;transform:translate(-50%,-50%);padding:0;background:transparent;display:flex;flex-direction:column;align-items:center;line-height:1.3;max-width:160rpx}
.guide-pin>text:first-child{font-size:51rpx;color:#0e8a75;text-shadow:0 1px 3px white}
.guide-pin>text:last-child{font-size:20rpx;color:#306853;background:white;border-radius:35rpx;padding:9rpx 18rpx;max-width:150rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.guide-pin.selected>text:first-child{color:#df9e46}
.guide-map-sheet{position:absolute;left:24rpx;right:24rpx;bottom:35rpx;padding:22rpx;background:rgba(255,255,255,.98);border-radius:24rpx;box-shadow:0 4rpx 24rpx rgba(52,104,52,.12)}
.guide-map-detail{display:flex;gap:20rpx;position:relative}
.guide-map-detail>image,.guide-map-placeholder{width:176rpx;height:180rpx;border-radius:14rpx;flex-shrink:0}
.guide-map-placeholder{background:#e9f3e8;color:#579a76;display:flex;align-items:center;justify-content:center;font-size:52rpx}
.guide-map-detail>view:nth-child(2){flex:1;min-width:0;display:flex;flex-direction:column;gap:12rpx}
.guide-map-detail>view>text:first-child{font-size:30rpx;font-weight:600;color:#233c2d}
.guide-map-label{font-size:21rpx;color:#389174;background:#edf6ed;border-radius:8rpx;padding:4rpx 9rpx;align-self:flex-start}
.guide-map-detail>view>text:last-child{font-size:23rpx;color:#849689;line-height:1.6}
.guide-map-actions{display:flex;gap:20rpx;margin-top:18rpx}
.guide-map-actions button{flex:1;background:#f4f8f4;color:#668672;font-size:24rpx;border-radius:40rpx}
.guide-map-actions button:last-child{flex:1.4;background:#087f70;color:white}
.guide-mode-button{font-size:22rpx;color:#087f70;position:fixed;right:22rpx;bottom:140rpx;z-index:15;border-radius:40rpx;background:white;box-shadow:0 2rpx 20rpx #e0e9e2}
.guide-mode-button{display:flex;align-items:center;justify-content:center;gap:8rpx;min-width:170rpx;height:68rpx;padding:0 22rpx;line-height:68rpx;white-space:nowrap;z-index:90}.guide-map-mode-button{position:absolute;bottom:24rpx}.guide-map-mode-button.with-sheet{bottom:372rpx}
