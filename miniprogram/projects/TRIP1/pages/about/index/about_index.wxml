<wxs module="media" src="../../../../../wxs/media.wxs"/>
<wxs module="rich" src="../../../../../wxs/rich_text.wxs"/>
<scenic-nav-bar bind:layout="bindScenicLayout" mode="{{isScenicAbout?navMode:'page'}}" title="{{isScenicAbout?'园区简介':(contentTitle||'园区信息')}}" overlay="{{isScenicAbout}}"/>
<block wx:if="{{isScenicAbout}}">
<view wx:if="{{!isLoad}}" class="wt-state">正在加载园区信息…</view>
<view wx:elif="{{previewError}}" class="wt-state">暂时无法预览，请检查登录状态和园区查看权限。</view><block wx:else>
<view class="scenic-cover"><image src="{{media.display(scenicRecord.SCENIC_IMAGES[0]||'../../../images/town/street-v1.jpg',mediaUrls)}}" mode="aspectFill"/><view class="cover-gradient"/><view class="cover-brand"><text>{{info.tagline||'拾光小镇 · 美好日常'}}</text></view><video wx:if="{{info.video}}" class="scenic-film" src="{{info.video}}" poster="{{scenicRecord.SCENIC_IMAGES[0]}}" controls show-center-play-btn/><view class="cover-bottom">拾光小镇 · 感受生活<text>向下滑动，了解园区</text><text class="icon-unfold"/></view></view>
<view class="scenic-tabs" style="top:{{uiChrome.height||88}}px"><button wx:for="{{tabs}}" wx:key="index" data-index="{{index}}" bindtap="section" class="{{activeSection===index?'active':''}}">{{item}}</button></view>
<view class="scenic-body">
<view id="section-0" class="scenic-section"><image wx:if="{{scenicRecord.SCENIC_IMAGES[0]}}" class="scenic-wide" src="{{media.display(scenicRecord.SCENIC_IMAGES[0],mediaUrls)}}" mode="aspectFill" bindtap="preview" data-src="{{media.display(scenicRecord.SCENIC_IMAGES[0],mediaUrls)}}"/><view class="scenic-summary"><text wx:if="{{scenicRecord.SCENIC_ADDRESS}}" class="scenic-address"><text class="icon-location"/> {{scenicRecord.SCENIC_ADDRESS}}</text><view wx:if="{{facts.length}}" class="scenic-facts"><view wx:for="{{facts}}" wx:key="label"><text>{{item.value}}</text><text>{{item.label}}</text></view></view></view><text wx:if="{{adminPreview}}" class="scenic-preview-label">管理员预览 · 未发布内容不会展示给游客</text><view wx:if="{{scenicRecord.SCENIC_DEMO}}" class="demo-notice">演示园区 · 内容仅供页面预览，可在后台替换</view><text class="section-title">园区概况</text><text wx:if="{{scenicRecord.SCENIC_DESC}}" class="scenic-copy">{{scenicRecord.SCENIC_DESC}}</text><view class="intro-content {{!expanded?'collapsed':''}}"><block wx:for="{{about}}" wx:key="index"><text wx:if="{{item.type==='text'}}" class="scenic-copy" style="{{rich.style(item)}}" user-select>{{item.val}}</text><image wx:elif="{{item.type==='img'}}" src="{{media.display(item.val,mediaUrls)}}" mode="widthFix" lazy-load bindtap="preview" data-src="{{media.display(item.val,mediaUrls)}}"/></block></view><button wx:if="{{about.length}}" class="scenic-expand" bindtap="bindExpand">{{expanded?'收起内容':'展开更多'}} <text class="icon-unfold"/></button></view>
<view id="section-1" class="scenic-section"><text class="section-title">特色体验</text><view wx:for="{{sections[0].items}}" wx:key="index" class="scenic-story"><image wx:if="{{item.image}}" class="scenic-wide" src="{{media.display(item.image,mediaUrls)}}" mode="aspectFill" lazy-load bindtap="preview" data-src="{{media.display(item.image,mediaUrls)}}"/><text class="card-title">{{item.title}}</text><text class="scenic-copy">{{item.desc}}</text></view><text wx:if="{{!sections[0].items.length}}" class="scenic-empty">园区特色内容正在整理中</text></view>
<view id="section-2" class="scenic-section"><text class="section-title">实用信息</text><view wx:if="{{info.visitDuration}}" class="practical-card"><text class="card-title">建议游玩时长</text><text class="scenic-copy">{{info.visitDuration}}</text></view><view wx:if="{{scenicRecord.SCENIC_HOURS}}" class="practical-card"><text class="card-title">开放时间</text><text class="scenic-copy">{{scenicRecord.SCENIC_HOURS}}</text></view><view wx:if="{{scenicRecord.SCENIC_ADDRESS}}" class="practical-card"><text class="card-title">园区地址</text><text class="scenic-copy">{{scenicRecord.SCENIC_ADDRESS}}</text><button class="scenic-outline" bindtap="copyAddress">复制地址</button><map wx:if="{{info.latitude!==undefined&&info.longitude!==undefined}}" class="scenic-map" latitude="{{info.latitude}}" longitude="{{info.longitude}}" markers="{{mapMarkers}}" scale="13"/><button wx:if="{{info.latitude!==undefined&&info.longitude!==undefined}}" class="scenic-outline" bindtap="openMap">打开地图导航</button></view><view wx:if="{{traffic.length}}" class="practical-card"><text class="card-title">交通指南</text><view wx:for="{{traffic}}" wx:key="title"><text class="traffic-title">{{item.title}}</text><text class="scenic-copy">{{item.text}}</text></view></view><view wx:if="{{info.tips}}" class="practical-card"><text class="card-title">温馨提示</text><text class="scenic-copy">{{info.tips}}</text></view></view>
</view>
</block></block><block wx:else><view wx:if="{{!isLoad}}" class="wt-state">正在加载园区信息…</view><view wx:else class="intro-page"><view class="intro-hero"><image src="{{media.display(scenicRecord.SCENIC_IMAGES[0]||'../../../images/town/street-v1.jpg',mediaUrls)}}" mode="aspectFill"/><view class="intro-shade"></view><view class="intro-poem"><text>{{scenicRecord.SCENIC_NAME||(isScenicAbout?'江纺1953':contentTitle)}}</text><text>{{isScenicAbout?'漫步小镇街区，感受江纺时光':'园区公共服务信息'}}</text></view></view><view wx:if="{{isScenicAbout}}" class="intro-ribbon">街区 · 人文 · 休闲 · 生活</view><view class="intro-body"><view class="intro-heading"><text>{{isScenicAbout?'关于园区':contentTitle}}</text></view><view wx:if="{{scenicRecord}}" class="intro-facts"><text>{{scenicRecord.SCENIC_DESC}}</text><text wx:if="{{scenicRecord.SCENIC_ADDRESS}}">地址：{{scenicRecord.SCENIC_ADDRESS}}</text><text wx:if="{{scenicRecord.SCENIC_HOURS}}">开放时间：{{scenicRecord.SCENIC_HOURS}}</text><button wx:if="{{scenicRecord.SCENIC_PHONE}}" bindtap="url" data-type="phone" data-url="{{scenicRecord.SCENIC_PHONE}}">电话咨询 {{scenicRecord.SCENIC_PHONE}}</button></view><view class="intro-content {{isScenicAbout&&!expanded?'collapsed':''}}"><block wx:for="{{about}}" wx:key="index"><text wx:if="{{item.type=='text'}}" class="intro-text" user-select>{{item.val}}</text><image wx:elif="{{item.type=='img'}}" src="{{media.display(item.val,mediaUrls)}}" mode="widthFix" lazy-load bindtap="url" data-type="img" data-url="{{item.val}}"/></block></view><button wx:if="{{isScenicAbout}}" class="intro-expand" bindtap="bindExpand">{{expanded?'收起内容':'展开更多'}} <text class="icon-{{expanded?'fold':'unfold'}}"></text></button><view wx:if="{{isScenicAbout}}" class="intro-values"><view><text class="icon-discover"></text><text>小镇生活</text></view><view><text class="icon-location"></text><text>自在游览</text></view></view><image wx:if="{{isScenicAbout}}" class="intro-landscape" src="../../../images/town/courtyard-v1.jpg" mode="aspectFill"/></view></view></block>
