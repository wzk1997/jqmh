.travel-tab-bar{position:fixed;left:0;right:0;bottom:0;z-index:1000;background:#fff;border-radius:28rpx 28rpx 0 0;box-shadow:0 -4rpx 22rpx rgba(90,53,43,.045);padding-bottom:env(safe-area-inset-bottom);overflow:hidden}.tab-mountains{position:absolute;left:0;bottom:0;width:100%;height:130rpx;opacity:.65;pointer-events:none}.travel-tabs{position:relative;height:128rpx;display:flex;align-items:center;padding:4rpx 10rpx;box-sizing:border-box}.travel-tab{flex:1;min-width:0;margin:0;padding:0;background:transparent;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2rpx;height:120rpx;line-height:1.4;color:#78675f;font-size:calc(24rpx * var(--wt-font-scale, 1));border-radius:18rpx}.travel-tab:after{border:0}.travel-tab-icon{width:70rpx;height:70rpx;display:block}.travel-tab.selected{color:#a44736;font-weight:600}.travel-tab.selected .travel-tab-icon{width:78rpx;height:78rpx}.travel-tab:active{background:rgba(246,230,227,.45)}
.travel-tab{gap:0}.travel-tab>text{line-height:1.35}.travel-tab-icon,.travel-tab.selected .travel-tab-icon{flex-shrink:0}

.travel-tabs{height:calc(96rpx + 32rpx * var(--wt-font-scale,1))}.travel-tab{height:auto;min-height:120rpx}
.display-enlarged .travel-tab-icon{width:80rpx;height:80rpx}
.display-enlarged .travel-tab.selected .travel-tab-icon{width:86rpx;height:86rpx}
