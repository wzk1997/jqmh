<page-meta page-style="--wt-font-scale:{{wtFontScale||1}};--wt-entry-caption-lines:{{wtFontScale>1?2:1}};--wt-entry-title-bottom:{{wtFontScale>1?62:31}}rpx;"/>
<scenic-nav-bar title="{{newsHeading||'活动资讯'}}" bind:layout="bindScenicLayout"/>
<view wx:if="{{!_params&&categoriesError}}" class="wt-state">分类加载失败<button bindtap="loadCategories">重新加载</button></view>
<view wx:elif="{{!_params}}" class="wt-state">正在加载资讯…</view>
<block wx:else>
  <view wx:if="{{_params&&categoriesError}}" class="wt-state">分类更新失败<button bindtap="loadCategories">重新加载</button></view>
  <cmpt-comm-list id="newsList" topOffset="{{uiChrome.height}}" heading="{{newsHeading}}" headingSubtitle="{{newsSubtitle}}" headingImage="{{waterfallLayout?'/projects/TRIP1/images/town/street-v1.jpg':''}}" headerHeight="{{waterfallLayout?280:160}}" filterMenus="{{newsFilters}}" filterValue="{{newsCategory}}" bind:filter="bindNewsCategory" type="news-list" search="{{search || ''}}" _params="{{_params}}" route="news/list" topBottom="120" placeholder="搜索资讯标题" bind:list="bindCommListCmpt">
    <news-waterfall enlarged="{{wtDisplayMode==='enlarged'}}" media-urls="{{mediaUrls}}" items="{{visibleNews}}"/>
    <view wx:if="{{dataList.list.length&&!visibleNews.length}}" class="wt-state">当前分类暂无内容</view><import src="../../../../../tpls/public/list_load_tpl.wxml" /><template is="listLoadTpl" data="{{skin:'load-project',dataList,noHint:'暂无符合条件的内容，试试其他分类或搜索词'}}" />
  </cmpt-comm-list>
</block>
<reading-tools id="readingTools"/>
