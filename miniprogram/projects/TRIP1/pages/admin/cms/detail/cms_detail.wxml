<wxs module="media" src="../../../../../../wxs/media.wxs"/>
<wxs module="rich" src="../../../../../../wxs/rich_text.wxs"/>
<scenic-nav-bar title="{{title}}"/><view wx:if="{{isAdmin}}" class="cms-page"><cms-state loading="{{loading}}" error="{{error}}" bind:retry="load"/><block wx:if="{{record && !loading && !error}}"><image wx:if="{{record.cover}}" class="cms-hero" src="{{media.display(record.cover,mediaUrls)}}" mode="aspectFill" bindtap="preview" data-url="{{record.cover}}"/><view class="cms-card"><view class="cms-row"><text class="cms-heading cms-row-copy">{{record.name}}</text><text class="cms-badge cms-badge-{{record.state}}">{{record.stateLabel}}</text></view><text wx:if="{{record.hasDraft}}" class="cms-meta">正在预览未发布的修改，游客端仍显示已发布版本</text><text class="cms-meta">{{record.categoryName}} 更新于 {{record.date}}</text><text wx:if="{{record.publishedAt}}" class="cms-meta">发布时间 {{record.publishedAt}}</text><view wx:if="{{record.desc}}" class="cms-rule"/><view class="cms-detail-text">{{record.desc}}</view><view wx:if="{{record.phone}}" class="cms-fact"><text class="cms-fact-label">联系电话</text><text user-select>{{record.phone}}</text><button class="cms-button cms-secondary" bindtap="phone" aria-label="拨打商家电话"><text class="icon-phone"/></button></view><view wx:if="{{record.address}}" class="cms-fact"><text class="cms-fact-label">详细地址</text><text user-select>{{record.address}}</text></view><view wx:if="{{record.hours}}" class="cms-fact"><text class="cms-fact-label">开放时间</text><text>{{record.hours}}</text></view><view wx:if="{{record.activityStart||record.activityEnd}}" class="cms-fact"><text class="cms-fact-label">活动时间</text><text>{{record.activityStart||'待公布'}}{{record.activityEnd?' 至 '+record.activityEnd:''}}</text></view><view class="cms-fact"><text class="cms-fact-label">展示排序</text><text>{{record.order}}</text></view><button wx:if="{{module==='scenic'}}" class="cms-button cms-secondary" bindtap="previewScenic">预览完整园区简介</button><view wx:if="{{module==='category'}}" class="cms-fact"><text class="cms-fact-label">分类编号</text><text>{{record.key}}</text></view></view><view wx:if="{{record.images.length>1}}" class="cms-card"><view class="cms-section-title">展示图片</view><view class="cms-photo-grid"><image wx:for="{{record.images}}" wx:key="*this" class="cms-photo" mode="aspectFill" src="{{media.display(item,mediaUrls)}}" bindtap="preview" data-url="{{item}}"/></view></view><view wx:if="{{relatedSpots.length}}" class="cms-card"><view class="cms-section-title">关联景点</view><button wx:for="{{relatedSpots}}" wx:key="id" class="cms-button cms-secondary" bindtap="openSpot" data-id="{{item.id}}" data-available="{{item.available}}" disabled="{{!item.available}}">{{item.name}} <text wx:if="{{item.available}}" class="icon-right"/></button></view><view wx:if="{{record.content.length}}" class="cms-card"><view class="cms-section-title">图文介绍</view><block wx:for="{{record.content}}" wx:key="index"><text wx:if="{{item.type==='text'}}" class="cms-detail-text" style="{{rich.style(item)}}">{{item.val}}</text><image wx:else class="cms-body-image" src="{{media.display(item.val,mediaUrls)}}" mode="widthFix"/></block></view><button wx:if="{{canPublish && record.state==='published' && record.hasDraft}}" class="cms-button cms-secondary" disabled="{{busy}}" bindtap="offline">下架已发布版本</button><view class="cms-bottom"><button wx:if="{{canWrite}}" class="cms-button cms-secondary" disabled="{{busy}}" bindtap="edit">编辑</button><button wx:if="{{canPublish}}" class="cms-button cms-primary" disabled="{{busy}}" bindtap="changeState">{{record.state==='published'&&!record.hasDraft?'下架':'发布'}}</button><button wx:if="{{canDelete}}" class="cms-button cms-danger" disabled="{{busy}}" bindtap="remove">删除</button></view></block></view>
