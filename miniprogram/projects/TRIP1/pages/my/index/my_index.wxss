@import "../../../style/design_v3.wxss";
page{background:#f7faf8;padding-bottom:calc(128rpx + env(safe-area-inset-bottom));box-sizing:border-box;color:#173e43}
.profile-hero{position:relative;overflow:hidden;padding-bottom:66rpx;background:#e5f3ee;box-sizing:border-box}
.profile-landscape,.profile-mist{position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none}
.profile-landscape{object-position:65% center}.profile-mist{background:linear-gradient(180deg,rgba(239,248,248,.3),rgba(242,249,246,.08) 25%,rgba(235,247,240,.86) 65%,#f7faf8 100%),linear-gradient(90deg,rgba(248,252,249,.91),rgba(243,249,246,.65) 52%,rgba(239,248,244,.06))}
.profile-intro{position:relative;padding:20rpx 48rpx 0}.profile-poem{display:block;white-space:pre-line;font-family:STKaiti,KaiTi,STSong,serif;color:#164d4c;font-size:42rpx;font-weight:600;line-height:1.42;letter-spacing:3rpx}.profile-brand{display:block;margin-top:18rpx;font-size:26rpx;color:#738b91;letter-spacing:1rpx}
.profile-user{position:relative;display:flex;align-items:center;gap:22rpx;margin:56rpx 38rpx 0;padding:0;min-height:136rpx;border-radius:0;background:transparent;text-align:left;line-height:1.6;color:#183940}.profile-user:after{border:0}.profile-avatar{width:130rpx;height:130rpx;background:linear-gradient(145deg,#eaf6f3,#bcded2);border:5rpx solid #fff;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 5rpx 22rpx rgba(33,83,68,.06)}.profile-avatar>image{width:80rpx;height:80rpx}.profile-user-copy{display:flex;flex-direction:column;flex:1;min-width:0;gap:7rpx}.profile-name{font-size:36rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.profile-caption{font-size:25rpx;color:#6a8188;line-height:1.65}.profile-user-arrow{font-size:28rpx;color:#748d87;flex-shrink:0}
.profile-quote{position:relative;text-align:right;padding:34rpx 48rpx 0;font-family:STKaiti,KaiTi,STSong,serif;font-size:27rpx;letter-spacing:3rpx;line-height:1.7;color:#195652}.profile-quote>text{display:block}.profile-quote>view{width:170rpx;height:2rpx;background:#74a69b;margin:12rpx 0 0 auto;transform:rotate(-8deg)}
.profile-body{position:relative;margin-top:-26rpx;padding:0 26rpx 36rpx}.profile-menu{background:#fff;border-radius:28rpx;padding:6rpx 24rpx;box-shadow:0 16rpx 42rpx rgba(40,82,68,.045)}.profile-menu-row{display:flex;align-items:center;gap:24rpx;min-height:150rpx;padding:24rpx 0;margin:0;border-radius:0;background:transparent;box-sizing:border-box;text-align:left;line-height:1.5;color:#173e43;border-bottom:1rpx solid #e9eeec}.profile-menu-row:after,.profile-services button:after,.profile-section-heading button:after{border:0}.profile-menu-row:last-child{border-bottom:0}.profile-menu-icon{width:78rpx;height:78rpx;border-radius:26rpx;display:flex;align-items:center;justify-content:center;font-size:43rpx;flex-shrink:0}.is-amber{background:#fff6e9;color:#f3a12a}.is-violet{background:#f3edff;color:#8956dc}.is-blue{background:#eaf2ff;color:#276bdf}.is-green{background:#e7f8f0;color:#14846d}.profile-menu-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:8rpx}.profile-menu-copy>text:first-child{font-size:32rpx;font-weight:600}.profile-menu-copy>text:last-child{font-size:25rpx;color:#829098}.profile-menu-row>text:last-child{font-size:28rpx;color:#84968f}
.profile-section-heading{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:30rpx 6rpx 10rpx}.profile-section-heading>text{font-size:32rpx;font-weight:600;white-space:nowrap}.profile-section-heading>button{margin:0;padding:0;min-height:88rpx;display:flex;align-items:center;gap:10rpx;background:transparent;color:#7c9295;font-size:24rpx;line-height:1.5;text-align:right}
.profile-services{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.profile-service-card{display:flex;align-items:center;gap:14rpx;margin:0;min-height:142rpx;padding:22rpx 16rpx;box-sizing:border-box;background:#fff;border-radius:24rpx;text-align:left;line-height:1.5;color:#173e43;box-shadow:0 8rpx 28rpx rgba(40,82,68,.025)}.profile-service-icon{display:flex;align-items:center;justify-content:center;width:65rpx;height:72rpx;border-radius:24rpx;flex-shrink:0;font-size:34rpx}.profile-service-card>view:nth-child(2){display:flex;flex-direction:column;gap:8rpx;flex:1;min-width:0}.profile-service-card>view:nth-child(2)>text:first-child{font-size:28rpx;font-weight:600}.profile-service-card>view:nth-child(2)>text:last-child{font-size:21rpx;color:#829098}.profile-service-card>text{font-size:22rpx;color:#84968f}
.profile-banner{position:relative;margin-top:24rpx;height:200rpx;border-radius:24rpx;overflow:hidden;background:#e7f2ed}.profile-banner>image,.profile-banner-mist{position:absolute;width:100%;height:100%;top:0;left:0}.profile-banner-mist{background:linear-gradient(90deg,rgba(237,247,244,.98),rgba(237,247,244,.89) 40%,rgba(237,247,244,.05) 100%)}.profile-banner-copy{position:relative;padding:24rpx 28rpx;display:flex;flex-direction:column;align-items:flex-start;gap:6rpx;color:#1d685b}.profile-banner-copy>text:first-child{font-family:STSong,serif;font-size:37rpx;font-weight:600;letter-spacing:2rpx}.profile-banner-copy>text:nth-child(2){font-size:25rpx}.profile-banner-copy>view{height:1rpx;width:120rpx;background:#bfd5cc;margin:8rpx 0}.profile-banner-copy>text:last-child{font-size:23rpx;color:#6e8789}
@media(max-width:350px){.profile-services{gap:12rpx}.profile-service-card{gap:10rpx;padding:20rpx 12rpx}.profile-service-icon{width:50rpx;font-size:30rpx}.profile-service-card>view:nth-child(2)>text:last-child{font-size:20rpx}.profile-poem{font-size:39rpx}}

.profile-hero{padding-bottom:50rpx;min-height:400rpx}.profile-intro{padding:6rpx 46rpx 0}.profile-poem{font-size:36rpx;line-height:1.4}.profile-brand{font-size:24rpx;margin-top:12rpx}.profile-user{margin:28rpx 36rpx 0;min-height:120rpx;gap:20rpx;justify-content:flex-start}.profile-avatar{width:120rpx;height:120rpx}.profile-avatar>image{width:76rpx;height:76rpx}.profile-user-copy{flex:0 1 245rpx;max-width:245rpx}.profile-name{font-size:32rpx}.profile-caption{font-size:23rpx}.profile-quote{position:absolute;right:28rpx;bottom:58rpx;padding:0;width:235rpx;font-size:23rpx;line-height:1.65;letter-spacing:1rpx}.profile-quote>view{width:170rpx;margin-top:10rpx}.profile-menu-row{min-height:140rpx;padding:22rpx 0;gap:24rpx}.profile-menu-copy>text:first-child{font-size:31rpx}.profile-menu-icon{width:74rpx;height:74rpx}.profile-section-heading{margin-top:22rpx}.profile-banner{height:190rpx}.profile-user-copy .profile-caption{white-space:nowrap;font-size:22rpx}@media(max-width:350px){.profile-quote{width:210rpx;font-size:21rpx}.profile-user-copy{max-width:210rpx}.profile-user-copy .profile-caption{white-space:normal}}

.profile-avatar{overflow:hidden}.profile-avatar>.profile-avatar-photo{width:100%;height:100%;border-radius:50%}
