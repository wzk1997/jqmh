<wxs module="media" src="../../../../../wxs/media.wxs"/>
<scenic-nav-bar title="吃住行" bind:layout="bindScenicLayout"/>
<view class="living-page"><view class="v3-light-heading"><text>吃住行</text></view><view class="living-tabs"><button wx:for="{{['food','stay','travel']}}" wx:key="*this" data-tab="{{item}}" bindtap="bindServiceTab" class="{{serviceTab==item?'active':''}}">{{item=='food'?'美食':item=='stay'?'住宿':'出行'}}</button></view>
<view class="living-list"><view class="living-row" wx:for="{{merchants}}" wx:key="id" bindtap="url" data-url="{{item.path}}"><image wx:if="{{item.pic}}" src="{{media.display(item.pic,mediaUrls)}}" mode="aspectFill"/><view class="living-copy"><text>{{item.title}}</text><text>{{item.desc}}</text><text>{{item.phone}}</text></view><text wx:if="{{item.demo}}" class="demo-tag">演示</text><button wx:if="{{item.phone}}" class="living-call" catchtap="url" data-type="phone" data-url="{{item.phone}}" aria-label="拨打商家电话"><text class="icon-phone"/></button></view></view>
<view class="living-list" wx:if="{{serviceTab!='travel'}}"><button class="living-row" wx:for="{{items}}" wx:key="id" bindtap="url" data-url="{{item.path}}"><image wx:if="{{item.pic}}" src="{{media.display(item.pic,mediaUrls)}}" mode="aspectFill"/><view wx:else class="living-placeholder"><text class="icon-{{serviceTab=='food'?'shop':'home'}}"></text></view><view class="living-copy"><text class="content-cut-two">{{item.title}}</text><text class="content-cut-two">{{item.desc||item.label}}</text><text>查看详情 <text class="icon-right"></text></text></view></button></view>
<view wx:else class="v3-menu living-travel"><button class="v3-menu-row" bindtap="url" data-url="../index/about_index?key=SETUP_CONTENT_BUS"><text class="v3-menu-icon icon-location"></text><view class="v3-menu-copy"><text>公交信息</text><text>公共交通出行指引</text></view><text class="icon-right"></text></button><button class="v3-menu-row" bindtap="url" data-url="../index/about_index?key=SETUP_CONTENT_PARKING"><text class="v3-menu-icon icon-ticket"></text><view class="v3-menu-copy"><text>停车场</text><text>查找景区停车信息</text></view><text class="icon-right"></text></button><button class="v3-menu-row" bindtap="url" data-type="relaunch" data-url="../../product/index/product_index"><text class="v3-menu-icon icon-discover"></text><view class="v3-menu-copy"><text>景区导览</text><text>浏览景点与游览信息</text></view><text class="icon-right"></text></button></view>
<view wx:if="{{loading}}" class="wt-state">正在加载…</view><view wx:elif="{{error}}" class="wt-state">暂时无法获取商家信息<button class="living-retry" bindtap="retry">重新加载</button></view><view wx:elif="{{!items.length&&!merchants.length&&serviceTab!=='travel'}}" class="wt-state">更多地方好去处，敬请期待</view><button wx:if="{{partialError}}" class="living-retry" bindtap="retry">部分信息加载失败，点击重试</button><button wx:if="{{hasMore&&!loading}}" class="living-load-more" bindtap="loadMore">加载更多</button><button class="living-footer" bindtap="url" data-url="../visitor/visitor_index">更多游客服务 <text class="icon-right"></text></button></view>
