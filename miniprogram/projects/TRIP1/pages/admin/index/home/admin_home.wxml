<scenic-nav-bar title="管理首页" back="{{false}}"/><view wx:if="{{isAdmin}}" class="cms-page"><view class="cms-card"><view class="cms-row"><image class="cms-brand" src="/projects/TRIP1/images/ui/home_v2_active.png" mode="aspectFit"/><view><text class="cms-meta">景区内容管理后台</text></view></view><view class="cms-rule"/><view class="cms-name">你好，{{admin.name||'管理员'}}</view><text class="cms-meta">维护内容，让景区更好地被看见</text></view><view class="cms-stats"><view wx:for="{{stat}}" wx:key="title" class="cms-stat"><text class="cms-stat-number">{{item.cnt||0}}</text><text class="cms-meta">{{item.title}}</text></view></view><view class="cms-section-title">内容管理</view><view class="cms-module-grid"><button wx:for="{{modules}}" wx:key="id" class="cms-module" bindtap="openModule" data-id="{{item.id}}"><text class="{{item.icon}} cms-module-icon"/><text>{{item.title}}</text></button></view><view class="cms-card"><button wx:if="{{canScenic}}" class="cms-settings-row" bindtap="url" data-url="../../portal/admin_portal"><text class="icon-home"/>首页配置<text class="icon-right"/></button><button wx:if="{{canProduct}}" class="cms-settings-row" bindtap="url" data-url="../../product/list/admin_product_list"><text class="icon-location"/>景点管理<text class="icon-right"/></button><button wx:if="{{canScenic}}" class="cms-settings-row" bindtap="url" data-url="../../setup/about_list/admin_setup_about_list"><text class="icon-edit"/>便捷服务介绍<text class="icon-right"/></button><button class="cms-settings-row" bindtap="url" data-url="../../mgr/log/admin_log_list"><text class="icon-footprint"/>操作日志<text class="icon-right"/></button><button wx:if="{{isSuperAdmin}}" class="cms-settings-row" bindtap="url" data-url="../../mgr/list/admin_mgr_list"><text class="icon-profile"/>管理员管理<text class="icon-right"/></button><button class="cms-settings-row" bindtap="url" data-url="../../mgr/pwd/admin_mgr_pwd"><text class="icon-lock"/>修改密码<text class="icon-right"/></button><button class="cms-settings-row" bindtap="url" data-url="../../setup/qr/admin_setup_qr"><text class="icon-qr_code"/>小程序二维码<text class="icon-right"/></button></view><button class="cms-button cms-secondary" bindtap="bindExitTap">退出登录</button></view>
