@import "../../../style/design_v3.wxss";
.portal-search-input{display:flex;align-items:center;margin:0 26rpx;padding:10rpx 10rpx 10rpx 25rpx;background:white;border-radius:50rpx;gap:15rpx;color:#7d9988}.portal-search-input input{flex:1;min-width:0;font-size:25rpx;height:66rpx}.portal-search-input button{background:#087f70;color:white;border-radius:40rpx;font-size:23rpx;line-height:66rpx;padding:0 22rpx}.search-types{display:flex;margin:22rpx 26rpx;gap:16rpx}.search-types button{background:white;border-radius:40rpx;flex:1;font-size:23rpx;padding:0;line-height:66rpx;color:#7d9183}.search-types .active{background:#087f70;color:white}.search-result{display:flex;align-items:center;gap:20rpx;padding:24rpx;margin:0 26rpx 16rpx;text-align:left;background:white;border-radius:18rpx}.search-result>image{width:160rpx;height:145rpx;border-radius:12rpx;flex-shrink:0}.search-result>view{flex:1;min-width:0;display:flex;flex-direction:column;gap:10rpx}.search-result>view>text:nth-child(2){font-size:28rpx;font-weight:600;color:#2a3e30}.search-result>view>text:last-child{font-size:22rpx;color:#8c9f90}.search-result-kind{font-size:20rpx;color:#178d70}.search-intro{padding:100rpx 20rpx;display:flex;flex-direction:column;align-items:center;gap:30rpx;color:#9aaca0;font-size:25rpx}.search-intro>text:first-child{font-size:90rpx;color:#c4dacb}.search-partial{text-align:center;color:#9b875f;font-size:22rpx;padding:25rpx}

.guide-search-page{background:white;min-height:calc(100vh - 120rpx);padding-top:24rpx}.guide-search-page .portal-search-input{background:#f2f6f5;border-radius:24rpx}.guide-search-page .guide-cancel{background:transparent;color:#39594d}.guide-search-page .search-types{gap:12rpx;border-bottom:1rpx solid #eef2ef}.guide-search-page .search-types button{border-radius:0;background:transparent;color:#7a8c83;min-height:88rpx;line-height:88rpx}.guide-search-page .search-types .active{color:#0f7469;border-bottom:4rpx solid #0f7469}.guide-search-page .search-result{border-radius:0;border-bottom:1rpx solid #eef2ef;padding:24rpx 0;margin-bottom:0}.guide-search-page .search-result>image{width:155rpx;height:120rpx}.guide-search-page .search-result-kind{display:none}
