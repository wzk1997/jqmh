@import "../../../style/design_v3.wxss";
page{background:#f1f8f5;color:#203b36}.guide-page{padding-bottom:calc(140rpx + env(safe-area-inset-bottom))}.guide-hero{height:370rpx;position:relative}.guide-hero-image,.guide-hero-shade{position:absolute;inset:0;width:100%;height:100%}.guide-hero-shade{background:linear-gradient(180deg,rgba(11,50,43,.1),rgba(7,49,43,.5))}.guide-hero-copy{position:absolute;left:32rpx;right:32rpx;top:75rpx;text-align:center;color:white;display:flex;flex-direction:column;gap:18rpx}.guide-hero-title{font-size:45rpx;font-weight:600;letter-spacing:2rpx}.guide-hero-subtitle{font-size:25rpx;letter-spacing:1rpx}.guide-sheet{position:relative;margin-top:-12rpx;background:#fff;border-radius:30rpx 30rpx 0 0;padding:28rpx}.guide-entries{display:flex;justify-content:space-between;margin-bottom:26rpx}.guide-entry{padding:0;margin:0;width:33.333%;background:transparent;font-size:24rpx;display:flex;flex-direction:column;align-items:center;gap:15rpx;min-height:130rpx;color:#34493f}.guide-entry:after{border:0}.guide-entry-icon{width:88rpx;height:88rpx;border-radius:26rpx;display:flex;align-items:center;justify-content:center;font-size:42rpx}.guide-entry-green{background:#e0f3ed;color:#08766b}.guide-entry-orange{background:#fff2df;color:#e59620}.guide-entry-blue{background:#e4efff;color:#407ed7}.guide-sort{display:flex;justify-content:space-between;border-bottom:1rpx solid #edf1ee;margin-bottom:8rpx}.guide-sort-button{background:transparent;margin:0;padding:0 8rpx;min-height:88rpx;line-height:88rpx;font-size:27rpx;color:#7c8991;border-radius:0;position:relative}.guide-sort-button:after{border:0}.guide-sort-button.active{color:#08776d;font-weight:600}.guide-sort-button.active:before{content:'';position:absolute;left:20%;right:20%;height:4rpx;background:#08776d;bottom:0;border-radius:4rpx}.guide-row{display:flex;align-items:center;gap:22rpx;width:100%;padding:25rpx 0;margin:0;background:white;min-height:180rpx;text-align:left;border-radius:0;line-height:normal;color:inherit}.guide-row:after{border:0;border-bottom:1rpx solid #edf2ee;border-radius:0}.guide-cover{width:170rpx;height:148rpx;border-radius:15rpx;flex-shrink:0}.guide-placeholder{background:#e5f1eb;color:#8fb6a5;display:flex;align-items:center;justify-content:center;font-size:42rpx}.guide-row-copy{flex:1;min-width:0}.guide-row-title{display:block;font-size:30rpx;font-weight:600;line-height:1.5}.guide-row-desc{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;font-size:24rpx;line-height:1.65;color:#829187;margin-top:10rpx}.guide-row-meta{display:flex;gap:18rpx;flex-wrap:wrap;font-size:21rpx;color:#7b8b86;margin-top:12rpx}.guide-row-arrow{background:#f2f8f5;color:#285649;width:44rpx;height:44rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:23rpx}.guide-state{padding:50rpx 20rpx;text-align:center;color:#839489;font-size:27rpx}.guide-state button,.guide-category button{background:#e9f4ee;color:#0d7567;font-size:26rpx;min-height:88rpx;border-radius:14rpx;margin-top:16rpx}.guide-category{display:flex;align-items:center;justify-content:space-between;color:#52796b;font-size:25rpx}.guide-category button{margin:12rpx 0;line-height:70rpx;min-height:70rpx}

.guide-hero{height:280rpx}.guide-hero-copy{top:84rpx}.guide-hero-title{font-family:STKaiti,KaiTi,STSong,serif;font-size:46rpx}.guide-sheet{padding:24rpx 28rpx}.guide-entries{margin-bottom:12rpx}.guide-entry{gap:12rpx;min-height:122rpx}.guide-entry-icon{width:82rpx;height:82rpx}.guide-sort{width:100%;margin-bottom:0;gap:0}.guide-sort-button{flex:1;min-width:0;text-align:center;font-size:27rpx;line-height:88rpx;padding:0 4rpx}.guide-sort-button.active:before{left:34%;right:34%}.guide-cover-wrap{position:relative;flex-shrink:0;width:170rpx;height:148rpx}.guide-rank{position:absolute;top:0;left:0;padding:5rpx 12rpx;background:#146c60;color:#fff;font-size:20rpx;line-height:1.4;border-radius:15rpx 0 12rpx 0}.guide-row{gap:20rpx;padding:22rpx 0;min-height:178rpx}.guide-row-desc{-webkit-line-clamp:1}.guide-row-meta{gap:14rpx;font-size:22rpx}.guide-row-arrow{flex-shrink:0}
