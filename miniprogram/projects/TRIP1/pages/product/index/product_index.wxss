@import "../../../style/skin.wxss";
.guide-links { display: flex; padding: 24rpx 32rpx 0; }
.guide-link { flex: 1; display: flex; justify-content: center; align-items: center; padding: 0 8rpx; margin: 0; background: #fff; color: var(--wt-brand); font-size: 24rpx; border-radius: 16rpx; height: 80rpx; line-height: 80rpx; }
.guide-link + .guide-link { margin-left: 16rpx; }
.guide-link::after { border: 0; }
.guide-link > text { margin-right: 8rpx; font-size: 28rpx; }
.product-list { padding: 24rpx 32rpx 0; }
.product-list .item { display: flex; width: 100%; padding: 24rpx; margin-bottom: 20rpx; background: white; border-radius: 24rpx; }
.guide-image { width: 190rpx; height: 224rpx; border-radius: 16rpx; flex-shrink: 0; }
.product-list .right { flex: 1; min-width: 0; margin-left: 24rpx; }
.product-list .category { display: block; color: var(--wt-brand); font-size: 22rpx; margin-bottom: 10rpx; }
.product-list .line1 { color: var(--wt-ink); font-size: 32rpx; font-weight: 600; line-height: 1.4; }
.product-list .line3 { color: var(--wt-muted); font-size: 25rpx; line-height: 1.7; margin-top: 12rpx; }
.guide-meta { display: flex; align-items: center; justify-content: space-between; margin-top: 20rpx; font-size: 22rpx; color: var(--wt-muted); }
.free-label { padding: 6rpx 10rpx; background: var(--wt-brand-soft); color: var(--wt-brand); border-radius: 8rpx; }

.guide-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; background: var(--wt-brand-soft); color: var(--wt-brand); font-size: 23rpx; }
.guide-empty > text:first-child { font-size: 56rpx; margin-bottom: 16rpx; }

.guide-map-page{height:calc(100vh - 128rpx - env(safe-area-inset-bottom));position:relative;overflow:hidden;background:#e7f1df}.guide-map-canvas{position:absolute;inset:0;transform-origin:center}.guide-map-canvas>image{width:100%;height:100%}.guide-map-top{position:absolute;top:24rpx;left:26rpx;right:26rpx}.guide-map-search{height:80rpx;line-height:80rpx;border-radius:45rpx;background:rgba(255,255,255,.95);font-size:23rpx;color:#829488;text-align:left;padding:0 25rpx}.guide-map-tabs{display:flex;gap:10rpx;margin-top:18rpx}.guide-map-tabs button{flex:1;padding:0 10rpx;font-size:21rpx;white-space:nowrap;line-height:65rpx;border-radius:40rpx;background:rgba(255,255,255,.95);color:#73867b}.guide-map-tabs .active{background:#087f70;color:white}.guide-map-note{display:block;background:rgba(255,255,255,.78);border-radius:15rpx;padding:8rpx 15rpx;margin-top:10rpx;font-size:19rpx;color:#728571;width:fit-content}.guide-pin{position:absolute;transform:translate(-50%,-50%);padding:0;background:transparent;display:flex;flex-direction:column;align-items:center;line-height:1.3;max-width:160rpx}.guide-pin>text:first-child{font-size:51rpx;color:#0e8a75;text-shadow:0 1px 3px white}.guide-pin>text:last-child{font-size:20rpx;color:#306853;background:white;border-radius:35rpx;padding:9rpx 18rpx;max-width:150rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.guide-pin.selected>text:first-child{color:#df9e46}.guide-map-tools{position:absolute;right:26rpx;top:45%;display:flex;flex-direction:column;gap:18rpx}.guide-map-tools button{height:80rpx;width:80rpx;padding:0;line-height:80rpx;border-radius:50%;font-size:42rpx;color:#2b6d58;background:white;box-shadow:0 2rpx 12rpx rgba(38,87,47,.15)}.guide-map-sheet,.guide-service-sheet{position:absolute;left:24rpx;right:24rpx;bottom:35rpx;padding:22rpx;background:rgba(255,255,255,.98);border-radius:24rpx;box-shadow:0 4rpx 24rpx rgba(52,104,52,.12)}.guide-map-detail{display:flex;gap:20rpx;position:relative}.guide-map-detail>image,.guide-map-placeholder{width:176rpx;height:180rpx;border-radius:14rpx;flex-shrink:0}.guide-map-placeholder{background:#e9f3e8;color:#579a76;display:flex;align-items:center;justify-content:center;font-size:52rpx}.guide-map-detail>view:nth-child(2){flex:1;min-width:0;display:flex;flex-direction:column;gap:12rpx;padding-right:35rpx}.guide-map-detail>view>text:first-child{font-size:30rpx;font-weight:600;color:#233c2d}.guide-map-label{font-size:21rpx;color:#389174;background:#edf6ed;border-radius:8rpx;padding:4rpx 9rpx;align-self:flex-start}.guide-map-detail>view>text:last-child{font-size:23rpx;color:#849689;line-height:1.6}.guide-sheet-close{position:absolute;right:0;top:0;background:transparent;padding:0;font-size:28rpx;color:#5b7768}.guide-map-actions{display:flex;gap:20rpx;margin-top:18rpx}.guide-map-actions button{flex:1;background:#f4f8f4;color:#668672;font-size:24rpx;border-radius:40rpx}.guide-map-actions button:last-child{flex:1.4;background:#087f70;color:white}.guide-service-sheet>text{display:block;font-size:27rpx;color:#65806b;margin-bottom:15rpx}.guide-service-sheet>text:first-child{font-weight:600;color:#243b2c}.guide-service-sheet button{font-size:24rpx;background:#f1f7f1;color:#3f8168;margin-top:12rpx;text-align:left;border-radius:14rpx}.guide-mode-button{font-size:22rpx;color:#087f70;position:fixed;right:22rpx;bottom:140rpx;z-index:15;border-radius:40rpx;background:white;box-shadow:0 2rpx 20rpx #e0e9e2}
