.portal-hero{height:920rpx;max-height:90vh;min-height:660rpx}.portal-title{left:38rpx;right:38rpx;bottom:174rpx;text-align:left;font-size:64rpx;line-height:1.32;white-space:pre-line;letter-spacing:3rpx}.portal-subtitle{left:38rpx;right:38rpx;bottom:108rpx;text-align:left;font-size:25rpx;line-height:1.6;letter-spacing:1rpx}.portal-dots{bottom:58rpx}.portal-slide-count{position:absolute;right:34rpx;bottom:54rpx;font-size:24rpx;pointer-events:none}.portal-slide-link{position:absolute;inset:0;width:100%;height:100%;padding:0;background:transparent;border-radius:0}.portal-body{margin-top:-18rpx;padding:28rpx 24rpx 50rpx;border-radius:0;background:#f7faf9}.portal-entries{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6rpx;background:white;border-radius:28rpx;padding:28rpx 8rpx;margin-bottom:44rpx}.portal-entries button{display:flex;align-items:center;flex-direction:column;background:transparent;padding:0 2rpx;line-height:1.5;gap:8rpx}.portal-entry-icon{width:100rpx;height:100rpx;border-radius:30rpx;display:flex;align-items:center;justify-content:center;background:#e6f4ec;color:#146c60;font-size:43rpx;margin-bottom:8rpx}.portal-entry-title{font-size:25rpx;font-weight:600;color:#182e30}.portal-entry-caption{font-size:21rpx;color:#798581}.portal-section{margin:40rpx 0 22rpx}.portal-featured-scroll{width:100%;white-space:nowrap}.portal-featured-track{display:flex;gap:18rpx;padding-bottom:4rpx}.portal-featured-card{flex-shrink:0;width:300rpx;padding:0;border-radius:20rpx;overflow:hidden;background:white;text-align:left;white-space:normal;line-height:1.5}.portal-featured-card image{display:block;width:100%;height:330rpx}.portal-featured-copy{padding:18rpx}.portal-card-title{display:block;font-size:27rpx;font-weight:600;color:#182e30}.portal-card-desc{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-size:23rpx;color:#798581;line-height:1.6;margin-top:6rpx}.portal-demo-label{font-size:20rpx;color:#7f8d86;display:block;margin-top:6rpx}.portal-season-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.portal-season-card{position:relative;height:320rpx;border-radius:20rpx;overflow:hidden;padding:0;background:#dfece6;text-align:left}.portal-season-card image,.portal-season-shade{position:absolute;inset:0;width:100%;height:100%}.portal-season-shade{background:linear-gradient(transparent 45%,rgba(13,45,37,.65))}.portal-season-card>text{position:absolute;left:20rpx;right:20rpx;bottom:22rpx;font-size:28rpx;font-weight:600;line-height:1.4;color:white}.portal-practical-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx}.portal-practical-card{display:flex;align-items:center;gap:16rpx;min-height:152rpx;background:white;padding:20rpx;border-radius:20rpx;text-align:left;line-height:1.5}.portal-practical-card>view{flex:1;min-width:0}.portal-practical-card .portal-card-title{font-size:25rpx}.portal-practical-icon{width:65rpx;height:65rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;background:#eaf5ef;color:#146c60;font-size:32rpx;flex-shrink:0}.portal-practical-card .portal-card-desc{font-size:21rpx}.portal-extra-services{display:flex;gap:16rpx;margin-top:32rpx}.portal-extra-services button{flex:1;background:white;border-radius:20rpx;color:#146c60;padding:22rpx 12rpx;font-size:26rpx;line-height:1.5}.portal-footer{display:flex;flex-direction:column;gap:18rpx;padding:70rpx 0 34rpx;color:#7f9b91;font-size:22rpx}.portal-footer-brand{font-size:50rpx;font-family:STKaiti,KaiTi,serif;letter-spacing:2rpx}
.portal-image-retry{position:absolute;top:40%;left:15%;width:70%;border-radius:40rpx;background:rgba(255,255,255,.92);color:#146c60;font-size:24rpx;line-height:1.5;padding:20rpx;z-index:2}
.portal-season-card,.portal-practical-card{width:100%;min-width:0;margin:0;box-sizing:border-box}
