:host{display:block;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
.display-preference{display:flex;align-items:center;justify-content:space-between;gap:16px;margin:6px 0 20px;padding:12px 0;border-top:1px solid #e9dad0;border-bottom:1px solid #e9dad0;color:#665047}
.display-preference-label{font-size:16px;line-height:1.5;flex-shrink:0}
.display-options{display:flex;align-items:center;gap:4px;padding:4px;border-radius:14px;background:#efe8e2}
.display-option{display:flex;align-items:center;justify-content:center;gap:4px;min-width:76px;min-height:44px;margin:0;padding:8px 12px;box-sizing:border-box;border:1px solid transparent;border-radius:10px;background:transparent;color:#705b52;font-size:16px;line-height:1.5}
.display-option:after{border:0}.display-option.is-selected{border-color:#d8b7a9;background:#fffaf5;color:#80382e;font-weight:600}
.display-choice-check{font-size:14px;line-height:1}.display-option-pressed{background:#f4e6de}
