@import "../../../style/design_v3.wxss";
page{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;background:#faf7f2;padding-bottom:calc(128rpx + env(safe-area-inset-bottom));box-sizing:border-box}
button:after{border:0}
.portal-hero{position:relative;height:calc(380rpx + 88px);color:#fff;background:#e9dfdc}
.portal-hero-loading,.portal-hero-swiper{position:absolute;inset:0;width:100%;height:100%}
.portal-hero-loading{background:#e9dfdc}
.portal-slide-image{display:block;width:100%;height:100%}
.portal-shade{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 0%,rgba(0,0,0,.6) 100%);pointer-events:none}
.portal-slide-link{position:absolute;inset:0;width:100%;height:100%;padding:0;border-radius:0;background:transparent}
.portal-title{position:absolute;left:24rpx;right:24rpx;bottom:118rpx;display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;font-family:STKaiti,KaiTi,STSong,serif;font-size:48rpx;font-weight:600;line-height:1.3;white-space:pre-line;text-shadow:0 2rpx 8rpx rgba(0,0,0,.2);pointer-events:none}
.portal-subtitle{position:absolute;left:24rpx;right:24rpx;bottom:78rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:24rpx;line-height:1.4;pointer-events:none}
.portal-dots{position:absolute;left:100rpx;right:100rpx;bottom:45rpx;display:flex;justify-content:center;align-items:center;gap:24rpx;pointer-events:none}
.portal-dots>view{width:16rpx;height:16rpx;border-radius:50%;background:rgba(255,255,255,.45)}
.portal-dots>view.active{background:#fff}
.portal-slide-count{position:absolute;right:24rpx;bottom:40rpx;font-size:24rpx;line-height:1.4;font-variant-numeric:tabular-nums;pointer-events:none}
.portal-image-retry{position:absolute;top:40%;left:15%;width:70%;padding:20rpx;border-radius:40rpx;background:rgba(255,255,255,.95);color:#a44736;font-size:24rpx;line-height:1.5}
.portal-body{position:relative;margin-top:-30rpx;padding:20rpx 24rpx 40rpx;border-radius:34rpx 34rpx 0 0;background:#faf7f2}
.portal-entry-title{display:block;font-size:29rpx;font-weight:600;line-height:1.45;white-space:nowrap}

.portal-card-pressed{opacity:.82}
.portal-demo-notice{display:block;margin:0 4rpx 20rpx;font-size:22rpx;line-height:1.6;color:#7d6c68}
.portal-section{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin:30rpx 0 20rpx}
.portal-section-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:5rpx}
.portal-section-title{position:relative;padding-left:24rpx;font-size:32rpx;font-weight:600;line-height:1.45;color:#382c28}
.portal-section-title:before{content:'';position:absolute;left:2rpx;top:9rpx;width:13rpx;height:29rpx;border-radius:15rpx 0 15rpx 0;background:#a44736;transform:rotate(25deg)}
.portal-section-subtitle{padding-left:24rpx;font-size:23rpx;line-height:1.5;color:#78675f}
.portal-section-more{display:flex;align-items:center;gap:7rpx;flex-shrink:0;min-height:88rpx;margin:0;padding:0;background:transparent;color:#78675f;font-size:23rpx;line-height:1.4}
.portal-section-more .icon-right{font-size:24rpx}
.portal-empty{display:flex;align-items:center;flex-direction:column;gap:24rpx;text-align:center;padding:44rpx 20rpx 52rpx;color:#78675f;font-size:24rpx}
.portal-empty-copy{font-size:24rpx;line-height:1.6;color:#847774}
.portal-empty .portal-retry-button{display:flex;align-items:center;justify-content:center;gap:12rpx;width:240rpx;min-height:88rpx;margin:0;padding:16rpx 28rpx;border:1rpx solid #e4d1cc;border-radius:44rpx;background:#f7efed;color:#a44736;font-family:inherit;font-size:26rpx;font-weight:500;line-height:1.4;box-sizing:border-box}
.portal-retry-icon{font-size:28rpx}
.portal-empty .portal-retry-pressed{background:#eee0dc}
.portal-empty .portal-retry-button.is-loading{background:#f5f1f0;border-color:#e7dedc;color:#92817d}
.portal-card-title{display:block;font-size:27rpx;font-weight:600;color:#382c28}
.portal-card-desc{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden;margin-top:6rpx;color:#78675f;font-size:23rpx;line-height:1.6}
.portal-demo-label{display:block;margin-top:6rpx;color:#78675f;font-size:20rpx}
.portal-footer{display:flex;flex-direction:column;gap:14rpx;padding:60rpx 0 30rpx;text-align:center;color:#806f6b;font-size:22rpx}

.portal-activity-heading{display:flex;align-items:center;gap:12rpx;flex:1;min-width:0}
.portal-leaf{width:60rpx;height:70rpx;flex-shrink:0}
.portal-activity-heading .portal-section-title,.portal-activity-heading .portal-section-subtitle{padding-left:0}
.portal-activity-heading .portal-section-title:before{display:none}

/* Updated reference: 343 × 176 main cards; three 226 × 100 supporting entries. */
.portal-entry-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin-bottom:20rpx}
.portal-entry-card{position:relative;display:block;width:100%;min-width:0;height:176rpx;margin:0;padding:0;overflow:hidden;border-radius:24rpx;background:#e5eef0;text-align:left;line-height:1.2;color:#442e28;box-sizing:border-box}
.portal-entry-image{position:absolute;inset:0;display:block;width:100%;height:100%}
/* The diagonal mask ends at 30%; the remaining image is completely unobscured. */
.portal-entry-shade{position:absolute;inset:0;background:linear-gradient(to top right,rgba(252,247,246,.98) 0%,rgba(252,247,246,.75) 15%,rgba(252,247,246,0) 30%);pointer-events:none}
.portal-entry-copy{position:absolute;inset:20rpx;min-width:0;pointer-events:none}
.portal-card-icon-wrap{position:absolute;top:0;left:0;display:flex;align-items:center;justify-content:center;width:56rpx;height:56rpx;border-radius:50%;background:rgba(248,238,235,.96)}
.portal-card-icon{display:block;width:40rpx;height:40rpx}
.portal-entry-card .portal-entry-title{position:absolute;left:0;right:44rpx;bottom:31rpx;display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-size:30rpx;font-style:normal;font-weight:600;line-height:1.3;letter-spacing:0;color:#442e28;text-shadow:none}
.portal-entry-caption{position:absolute;left:0;right:42rpx;bottom:0;display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-family:"PingFang SC","Microsoft YaHei",sans-serif;font-size:22rpx;font-style:normal;font-weight:400;line-height:1.4;letter-spacing:0;color:#645652;text-shadow:none}
.portal-entry-arrow{position:absolute;right:20rpx;bottom:20rpx;display:flex;align-items:center;justify-content:center;width:40rpx;height:40rpx;border-radius:50%;background:#fff;color:#a44736;font-size:24rpx}
.portal-entry-utilities{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12rpx;margin-bottom:20rpx}
.portal-entry-utilities>button{display:flex;align-items:center;gap:10rpx;width:100%;height:100rpx;min-width:0;margin:0;padding:12rpx;border-radius:20rpx;background:#fff;box-shadow:0 4rpx 16rpx rgba(0,0,0,.06);line-height:1.2;text-align:left;box-sizing:border-box}
.portal-utility-icon{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;flex-shrink:0;border-radius:50%;background:#f4e6de}
.portal-utility-icon image{display:block;width:40rpx;height:40rpx}
.portal-utility-copy{flex:1;min-width:0;overflow:hidden}
.portal-entry-utilities .portal-entry-title{display:block;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#442e28;font-size:24rpx;font-weight:600;line-height:1.4}
.portal-utility-caption{display:block;margin-top:6rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#78675f;font-size:20rpx;font-weight:400;line-height:1.4}
.portal-utility-arrow{display:none}

/* Soft white section surface; article bodies stay opaque white above it. */
.portal-news-section{margin:28rpx -24rpx 0;padding:0 24rpx 24rpx;border-radius:28rpx;background:rgba(255,255,255,.82)}
.portal-news-section>.portal-section{margin-top:0;padding-top:12rpx}

.portal-preview-notice{display:block;margin:0 0 16rpx;text-align:center;font-size:20rpx;line-height:1.5;color:#847571}
