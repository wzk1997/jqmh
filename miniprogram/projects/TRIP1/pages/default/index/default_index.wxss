@import "../../../style/design_v3.wxss";
page{background:#f5f8f7}.portal-hero{height:610rpx;position:relative;color:white}.portal-hero>image,.portal-shade{position:absolute;width:100%;height:100%}.portal-shade{background:linear-gradient(180deg,rgba(12,47,47,.04),rgba(8,40,32,.05) 45%,rgba(7,39,31,.52))}.portal-tools{position:absolute;left:30rpx;right:30rpx;display:flex;gap:22rpx;align-items:center}.portal-open{font-size:21rpx;display:flex;gap:8rpx;align-items:center;white-space:nowrap;text-shadow:0 1px 3px #365e63}.portal-open .icon-discover{font-size:32rpx}.portal-brand{position:absolute;left:34rpx;bottom:222rpx;font-size:22rpx;letter-spacing:4rpx}.portal-title{position:absolute;left:32rpx;bottom:128rpx;font-family:STSong,Songti SC,serif;font-size:58rpx;letter-spacing:3rpx;font-weight:600;text-shadow:0 2px 12px #214440}.portal-subtitle{position:absolute;left:34rpx;bottom:85rpx;font-size:23rpx;letter-spacing:2rpx}.portal-body{position:relative;margin-top:-38rpx;border-radius:36rpx 36rpx 0 0;padding:24rpx 24rpx 40rpx;background:#f7faf9}.portal-notice{display:flex;align-items:center;gap:12rpx;height:78rpx;background:white;border-radius:50rpx;padding:0 20rpx;font-size:22rpx;text-align:left}.notice-label{font-weight:600;white-space:nowrap}.notice-copy{flex:1;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:#798581}.portal-core{display:flex;gap:18rpx;margin-top:22rpx}.core-card{position:relative;flex:1;height:288rpx;border-radius:22rpx;background:#e0f0e8;padding:0;text-align:left;overflow:hidden}.core-card.blue{background:#e1eef8}.core-copy{position:absolute;top:22rpx;left:22rpx;z-index:2;display:flex;flex-direction:column;gap:6rpx;color:#172b2e}.core-copy>text:first-child{font-size:31rpx;font-weight:650}.core-copy>text:last-child{font-size:21rpx;color:#5c7775}.core-card image{position:absolute;bottom:0;width:100%;height:178rpx;border-radius:70rpx 0 0 0}.core-arrow{position:absolute;bottom:18rpx;right:18rpx;width:46rpx;height:46rpx;border-radius:50%;background:rgba(255,255,255,.92);text-align:center;line-height:46rpx;font-size:30rpx;color:#0e7867}.portal-features{display:flex;gap:14rpx;margin-top:18rpx}.portal-features button{flex:1;background:#e9f5ef;border-radius:20rpx;display:flex;flex-direction:column;align-items:center;padding:23rpx 4rpx 20rpx;line-height:1.5;font-size:26rpx;font-weight:600}.portal-features .blue{background:#eaf4fc}.portal-features .orange{background:#fff3e7}.feature-icon{font-size:43rpx;color:#0ba18a;margin-bottom:10rpx}.blue .feature-icon{color:#3c9eda}.orange .feature-icon{color:#ef9b33}.feature-caption{font-size:20rpx;color:#71817f;font-weight:400;margin-top:4rpx}.portal-utilities{display:flex;padding:28rpx 0 18rpx}.portal-utilities button{flex:1;padding:0;background:transparent;display:flex;align-items:center;flex-direction:column;line-height:1.5;font-size:22rpx;gap:10rpx}.utility-icon{height:76rpx;width:76rpx;line-height:76rpx;border-radius:50%;font-size:35rpx}.orange.utility-icon{background:#fff0de;color:#e99328}.purple.utility-icon{background:#f1edff;color:#8a6ad8}.teal.utility-icon{background:#e4f6ee;color:#0fa18a}.blue.utility-icon{background:#eaf1fc;color:#548fd1}.portal-section{display:flex;align-items:center;justify-content:space-between;margin:18rpx 0 24rpx}.portal-section>view{display:flex;flex-direction:column;gap:6rpx}.portal-section>view>text:first-child{font-size:34rpx;font-weight:650;color:#182e30}.portal-section>view>text:last-child{font-size:22rpx;color:#8a9995}.portal-section button{font-size:22rpx;color:#7c8c88;background:transparent;padding:10rpx 0}.portal-footer{text-align:center;color:#a4afaa;font-size:21rpx;padding:42rpx 0 8rpx;letter-spacing:2rpx}.portal-empty{text-align:center;padding:50rpx 0;font-size:24rpx;color:#8a9995}.portal-empty button{margin-top:20rpx;font-size:24rpx;background:white;color:#087f70}button:after{border:0}
