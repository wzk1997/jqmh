<wxs module="media" src="../../../../../wxs/media.wxs"/>
<scenic-nav-bar title="首页配置"/>
<view wx:if="{{isAdmin}}" class="cms-page"><cms-state loading="{{loading}}" error="{{error}}" bind:retry="load"/><block wx:if="{{!loading}}">
<block wx:if="{{!choosing}}"><view class="cms-card"><view class="cms-section-title">关联景区</view><text class="cms-meta">草稿保存后不会影响游客端，发布后生效。首页配置使用景区管理权限。</text><text class="cms-label">关联景区</text><text class="portal-reference">{{scenicName||(config.scenicId?'关联景区不可用，请重新选择':'尚未关联景区')}}</text><button wx:if="{{canWrite}}" class="cms-button cms-secondary" bindtap="choose" data-for="scenic">选择已发布景区</button></view>
<view class="cms-card"><view class="cms-section-title">顶部轮播</view><text class="cms-meta">最多8张，支持 JPG、PNG，单张不超过5MB。按列表顺序播放。</text><view wx:for="{{config.slides}}" wx:key="index" class="portal-edit-slide"><image class="portal-edit-image" src="{{media.display(item.image,mediaUrls)}}" mode="aspectFill"/><view class="cms-field"><text class="cms-label">标题 *</text><textarea class="cms-input cms-textarea" auto-height value="{{item.title}}" data-index="{{index}}" data-field="title" bindinput="input" maxlength="60" disabled="{{!canWrite}}"/></view><view class="cms-field"><text class="cms-label">副标题</text><input class="cms-input" value="{{item.subtitle}}" data-index="{{index}}" data-field="subtitle" bindinput="input" maxlength="120" disabled="{{!canWrite}}"/></view><view class="portal-enabled"><text class="cms-label">启用</text><switch checked="{{item.enabled}}" color="#146C60" data-index="{{index}}" bindchange="enabled" disabled="{{!canWrite}}"/></view><text class="portal-reference">{{item.target?(referenceNames[item.target.module+':'+item.target.id]||'关联内容不可用，请重新选择'):'不跳转，仅展示风景'}}</text><view wx:if="{{canWrite}}" class="portal-edit-actions"><button bindtap="image" data-index="{{index}}">更换图片</button><button bindtap="choose" data-for="slide" data-index="{{index}}">关联内容</button><button bindtap="clearTarget" data-index="{{index}}">取消跳转</button></view><view wx:if="{{canWrite}}" class="portal-edit-actions"><button bindtap="move" data-group="slides" data-index="{{index}}" data-delta="-1" disabled="{{index===0}}">上移</button><button bindtap="move" data-group="slides" data-index="{{index}}" data-delta="1" disabled="{{index===config.slides.length-1}}">下移</button><button class="cms-danger" bindtap="remove" data-group="slides" data-index="{{index}}">移除</button></view></view><button wx:if="{{canWrite && config.slides.length<8}}" class="cms-button cms-secondary" bindtap="image">＋ 上传轮播图</button></view>
<view class="cms-card"><view class="cms-section-title">精选推荐</view><text class="cms-meta">选择已发布内容，最多12项。这里只保存关联和顺序，原内容下架后首页自动隐藏。</text><view wx:for="{{config.featured}}" wx:key="index" class="portal-edit-slide"><text class="cms-label">{{referenceNames[item.module+':'+item.id]||'内容已下架或不可用'}}</text><text class="portal-reference">{{moduleNames[item.module]}}</text><view wx:if="{{canWrite}}" class="portal-edit-actions"><button bindtap="move" data-group="featured" data-index="{{index}}" data-delta="-1" disabled="{{index===0}}">上移</button><button bindtap="move" data-group="featured" data-index="{{index}}" data-delta="1" disabled="{{index===config.featured.length-1}}">下移</button><button class="cms-danger" bindtap="remove" data-group="featured" data-index="{{index}}">移除</button></view></view><button wx:if="{{canWrite && config.featured.length<12}}" class="cms-button cms-secondary" bindtap="choose" data-for="featured">＋ 选择推荐内容</button></view>
<view wx:if="{{canWrite}}" class="cms-bottom"><button class="cms-button cms-secondary" bindtap="save" disabled="{{saving}}" loading="{{saving}}">保存草稿</button><button wx:if="{{canPublish}}" class="cms-button cms-primary" bindtap="save" data-publish="true" disabled="{{saving}}">发布首页</button></view></block>
<view wx:else class="cms-card"><view class="cms-section-title">选择已发布内容</view><view wx:if="{{pickFor!=='scenic'}}" class="portal-choice-types"><button wx:for="{{choiceTypes}}" wx:key="id" bindtap="type" data-id="{{item.id}}" class="{{choiceModule===item.id?'active':''}}">{{item.name}}</button></view><input class="cms-input" placeholder="搜索内容名称" value="{{choiceSearch}}" bindinput="searchInput" bindconfirm="loadChoices"/><button class="cms-button cms-secondary" bindtap="loadChoices">搜索</button><button wx:for="{{choices}}" wx:key="id" class="portal-choice-row" bindtap="pick" data-index="{{index}}"><image wx:if="{{item.cover}}" src="{{media.display(item.cover,mediaUrls)}}" mode="aspectFill"/><text>{{item.name}}</text></button><text wx:if="{{!choices.length&&!choiceLoading}}" class="cms-meta">暂无已发布内容</text><button wx:if="{{choiceMore}}" class="cms-button cms-secondary" bindtap="loadMore">加载更多</button><button class="cms-button cms-secondary" bindtap="close">返回配置</button></view>
</block></view>
