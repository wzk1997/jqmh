:host{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif}
/* Fixed physical sizes keep the control reachable in both display modes. */
.display-dock{position:fixed;right:0;bottom:calc(140px + env(safe-area-inset-bottom));z-index:900;display:flex;align-items:center;gap:0}
.display-panel{width:0;opacity:0;transform:translateX(16px);pointer-events:none;transition:transform .2s ease,opacity .2s ease;overflow:hidden}
.is-expanded .display-panel{width:188px;opacity:1;transform:translateX(0);pointer-events:auto;overflow:visible}
.display-options{display:flex;align-items:center;gap:4px;padding:5px;border:1px solid #e3ccc2;border-radius:18px;background:#fffaf5;box-shadow:0 4px 18px rgba(82,40,29,.13);box-sizing:border-box;width:188px}
.display-option{display:flex;flex:1;align-items:center;justify-content:center;gap:4px;min-width:0;min-height:44px;margin:0;padding:8px 9px;box-sizing:border-box;border:1px solid transparent;border-radius:13px;background:transparent;color:#705b52;font-size:16px;line-height:1.5}
.display-option:after,.display-trigger:after{border:0}
.display-option.is-selected{border-color:#dfb7a9;background:#f3e2da;color:#80382e;font-weight:600}
.display-choice-check{font-size:14px;line-height:1}.display-option-pressed{background:#ecd7cb}
.display-trigger{position:relative;display:flex;align-items:center;justify-content:flex-end;flex-shrink:0;width:44px;height:56px;margin:0;padding:0;border:0;border-radius:0;background:transparent;color:#a44736;overflow:visible;line-height:1}
.display-trigger-surface{width:30px;height:52px;box-sizing:border-box;display:flex;align-items:center;justify-content:center;border:1px solid #e3ccc2;border-right:0;border-radius:18px 0 0 18px;background:#fffaf5;box-shadow:-2px 2px 10px rgba(103,46,34,.1)}
.display-trigger-chevron{width:9px;height:9px;border-left:2px solid #a44736;border-bottom:2px solid #a44736;transform:translateX(2px) rotate(45deg);transition:transform .2s ease}
.is-expanded .display-trigger-chevron{transform:translateX(-2px) rotate(225deg)}
.display-trigger-pressed .display-trigger-surface{background:#f3e2da}
@media (prefers-reduced-motion:reduce){.display-panel,.display-trigger-chevron{transition:none}}
