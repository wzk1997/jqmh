<wxs module="media" src="../../../../../wxs/media.wxs"/>
<view class="portal"><scenic-nav-bar bind:layout="bindScenicLayout" mode="{{homeNavMode}}" title="{{brandName||'WeTravel'}}" subtitle="{{homeNavMode==='home'?'与自然 · 遇见更好的自己':''}}" brand="{{homeNavMode==='home'}}" back="{{false}}" overlay search searchUrl="/projects/TRIP1/pages/search/portal/portal_search"/>
<view class="portal-hero"><swiper wx:if="{{heroRender}}" class="portal-hero-swiper" autoplay="{{heroPlaying}}" circular interval="5000" duration="600" current="{{heroIndex}}" bindchange="bindHeroChange" aria-label="景区风景轮播"><swiper-item wx:for="{{heroSlides}}" wx:key="image"><image class="portal-slide-image" src="{{media.display(item.image,mediaUrls)}}" mode="aspectFill" data-index="{{index}}" bindload="heroImageLoaded" binderror="heroImageError"/><view class="portal-shade"/><button wx:if="{{item.path}}" class="portal-slide-link" bindtap="heroTap" data-index="{{index}}" aria-label="{{item.title||item.label}}，查看详情"/></swiper-item></swiper><button wx:if="{{heroImageErrors[heroIndex]}}" class="portal-image-retry" bindtap="retryHero">图片暂不可用，点击重试</button><view class="portal-title">{{heroSlides[heroIndex].title||'山水相逢\n不负好时光'}}</view><view class="portal-subtitle">{{heroSlides[heroIndex].subtitle}}</view><view wx:if="{{heroSlides.length>1}}" class="portal-dots"><view wx:for="{{heroSlides}}" wx:key="image" class="{{heroIndex===index?'active':''}}"/></view><text wx:if="{{heroSlides.length>1}}" class="portal-slide-count">{{heroIndex+1}} / {{heroSlides.length}}</text></view>
<view class="portal-body"><view class="portal-entries">
<button bindtap="url" data-url="{{scenicAboutUrl}}"><text class="portal-entry-icon icon-discover"/><text class="portal-entry-title">景区简介</text><text class="portal-entry-caption">走进山水</text></button>
<button bindtap="url" data-type="relaunch" data-url="../../spot/index/spot_index"><text class="portal-entry-icon icon-location"/><text class="portal-entry-title">景区导览</text><text class="portal-entry-caption">轻松游览</text></button>
<button bindtap="url" data-type="relaunch" data-url="../../guide/index/guide_index"><text class="portal-entry-icon icon-pic"/><text class="portal-entry-title">园区攻略</text><text class="portal-entry-caption">玩转精彩</text></button>
<button bindtap="url" data-url="../../about/service/about_service"><text class="portal-entry-icon icon-shop"/><text class="portal-entry-title">吃住行</text><text class="portal-entry-caption">美食住宿</text></button></view>
<text wx:if="{{portalScenic.SCENIC_DEMO}}" class="portal-demo-notice">演示景区 · 图片与内容可在后台替换</text><view class="portal-section"><view class="portal-section-copy"><text class="portal-section-title">活动资讯</text><text class="portal-section-subtitle">发现更多精彩</text></view><button class="portal-section-more" bindtap="bindAllNews">查看全部 <text class="icon-right"/></button></view><news-waterfall media-urls="{{mediaUrls}}" items="{{waterfallItems}}"/>
<view wx:if="{{homeLoading&&!hasHomeLoaded}}" class="wt-state">正在发现精彩…</view><view wx:if="{{!homeLoading&&!waterfallItems.length}}" class="portal-empty"><text>{{homeError?'暂时无法获取资讯':'新的景区故事，即将与你相遇'}}</text><button wx:if="{{homeError}}" bindtap="_loadList">重新加载</button></view>
<block wx:if="{{portalFeatured.length}}"><view class="portal-section"><view class="portal-section-copy"><text class="portal-section-title">精选推荐</text><text class="portal-section-subtitle">精彩内容 · 不容错过</text></view></view><scroll-view scroll-x class="portal-featured-scroll"><view class="portal-featured-track"><button wx:for="{{portalFeatured}}" wx:key="id" class="portal-featured-card" bindtap="url" data-url="{{item.path}}"><image wx:if="{{item.pic}}" src="{{media.display(item.pic,mediaUrls)}}" mode="aspectFill" lazy-load/><view class="portal-featured-copy"><text class="portal-card-title">{{item.title}}</text><text wx:if="{{item.demo}}" class="portal-demo-label">演示内容</text><text class="portal-card-desc">{{item.desc}}</text></view></button></view></scroll-view></block>
<block wx:if="{{seasons.length}}"><view class="portal-section"><view class="portal-section-copy"><text class="portal-section-title">四季山水</text><text class="portal-section-subtitle">不同的季节，不同的美</text></view><button class="portal-section-more" bindtap="url" data-url="{{scenicAboutUrl+'&section=1'}}">查看更多 <text class="icon-right"/></button></view><view class="portal-season-grid"><button wx:for="{{seasons}}" wx:key="season" class="portal-season-card" bindtap="url" data-url="{{scenicAboutUrl+'&section=1'}}"><image wx:if="{{item.image}}" src="{{media.display(item.image,mediaUrls)}}" mode="aspectFill" lazy-load/><view class="portal-season-shade"/><text>{{item.title}}</text></button></view></block>
<block wx:if="{{practical.length}}"><view class="portal-section"><view class="portal-section-copy"><text class="portal-section-title">实用信息</text><text class="portal-section-subtitle">让旅行更轻松</text></view><button class="portal-section-more" bindtap="url" data-url="{{scenicAboutUrl+'&section=4'}}">查看更多 <text class="icon-right"/></button></view><view class="portal-practical-grid"><button wx:for="{{practical}}" wx:key="title" class="portal-practical-card" bindtap="url" data-url="{{scenicAboutUrl+'&section=4'}}"><text class="portal-practical-icon icon-{{item.icon}}"/><view><text class="portal-card-title">{{item.title}}</text><text class="portal-card-desc">{{item.text}}</text></view></button></view></block>
<view class="portal-extra-services"><button bindtap="url" data-url="../../experience/panorama/panorama_index"><text class="icon-camera"/> 全景漫游 <text class="icon-right"/></button><button bindtap="url" data-url="../../about/visitor/visitor_index"><text class="icon-service"/> 游客服务 <text class="icon-right"/></button></view><view class="portal-footer"><text class="portal-footer-brand">WeTravel</text><text>山水之间 · 生活本该如此</text><text>自然友好 · 文明出游 · 绿色旅行</text></view></view></view>
