<scenic-nav-bar title="反馈详情"/><view wx:if="{{isAdmin}}" class="cms-page"><cms-state loading="{{loading}}" error="{{error}}" bind:retry="load"/><block wx:if="{{record&&!loading&&!error}}"><view class="cms-card"><view class="cms-row"><text class="cms-section-title cms-row-copy">{{record.FEEDBACK_CATEGORY}}</text><text class="cms-badge {{record.FEEDBACK_STATUS===1?'cms-badge-published':'cms-badge-draft'}}">{{record.statusName}}</text></view><text class="cms-meta">提交时间 {{record.date}}</text><view wx:if="{{record.FEEDBACK_PHONE}}" class="cms-fact"><text class="cms-fact-label">联系电话</text><text user-select>{{record.FEEDBACK_PHONE}}</text></view><view class="cms-rule"/><text class="cms-detail-text">{{record.FEEDBACK_CONTENT}}</text><view class="cms-photo-grid"><image wx:for="{{record.FEEDBACK_IMAGE_URLS}}" wx:key="*this" class="cms-photo" src="{{item}}" mode="aspectFill" bindtap="preview" data-index="{{index}}"/></view></view><view class="cms-card"><view class="cms-section-title">处理回复</view><text wx:if="{{record.processTime}}" class="cms-meta">处理时间 {{record.processTime}}</text><textarea disabled="{{!canWrite}}" class="cms-input cms-textarea" value="{{reply}}" bindinput="input" maxlength="500" auto-height placeholder="填写处理结果或回复游客"/><text class="cms-meta">{{reply.length}}/500</text></view><view wx:if="{{canWrite}}" class="cms-bottom"><button class="cms-button cms-secondary" bindtap="process" disabled="{{saving||record.FEEDBACK_STATUS===2}}">标记处理中</button><button class="cms-button cms-primary" bindtap="reply" disabled="{{saving}}" loading="{{saving}}">保存回复</button></view></block></view>
