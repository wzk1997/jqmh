@import "../../../style/design_v3.wxss";
.portal-search-input{display:flex;align-items:center;margin:0 26rpx;padding:10rpx 10rpx 10rpx 25rpx;background:white;border-radius:50rpx;gap:15rpx;color:#99837d}.portal-search-input input{flex:1;min-width:0;font-size:calc(25rpx * var(--wt-font-scale, 1));height:66rpx}.portal-search-input button{background:#a44736;color:white;border-radius:40rpx;font-size:calc(23rpx * var(--wt-font-scale, 1));line-height:66rpx;padding:0 22rpx}.search-types{display:flex;margin:22rpx 26rpx;gap:16rpx}.search-types button{background:white;border-radius:40rpx;flex:1;font-size:calc(23rpx * var(--wt-font-scale, 1));padding:0;line-height:66rpx;color:#91817d}.search-types .active{background:#a44736;color:white}.search-result{display:flex;align-items:center;gap:20rpx;padding:24rpx;margin:0 26rpx 16rpx;text-align:left;background:white;border-radius:18rpx}.search-result>image{width:160rpx;height:145rpx;border-radius:12rpx;flex-shrink:0}.search-result>view{flex:1;min-width:0;display:flex;flex-direction:column;gap:10rpx}.search-result>view>text:nth-child(2){font-size:calc(28rpx * var(--wt-font-scale, 1));font-weight:600;color:#3e2e2a}.search-result>view>text:last-child{font-size:calc(22rpx * var(--wt-font-scale, 1));color:#9f908c}.search-result-kind{font-size:calc(20rpx * var(--wt-font-scale, 1));color:#6f4135}.search-intro{padding:100rpx 20rpx;display:flex;flex-direction:column;align-items:center;gap:30rpx;color:#ac9e9a;font-size:calc(25rpx * var(--wt-font-scale, 1))}.search-intro>text:first-child{font-size:calc(90rpx * var(--wt-font-scale, 1));color:#dac9c4}.search-partial{text-align:center;color:#9b875f;font-size:calc(22rpx * var(--wt-font-scale, 1));padding:25rpx}

.guide-search-page{background:white;min-height:calc(100vh - 120rpx);padding-top:24rpx}.guide-search-page .portal-search-input{background:#f6f3f2;border-radius:24rpx}.guide-search-page .guide-cancel{background:transparent;color:#594039}.guide-search-page .search-types{gap:12rpx;border-bottom:1rpx solid #f2efee}.guide-search-page .search-types button{border-radius:0;background:transparent;color:#8c7e7a;min-height:88rpx;line-height:88rpx}.guide-search-page .search-types .active{color:#a44736;border-bottom:4rpx solid #a44736}.guide-search-page .search-result{border-radius:0;border-bottom:1rpx solid #f2efee;padding:24rpx 0;margin-bottom:0}.guide-search-page .search-result>image{width:155rpx;height:120rpx}.guide-search-page .search-result-kind{display:none}
