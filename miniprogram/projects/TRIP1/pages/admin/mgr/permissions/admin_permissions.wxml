<scenic-nav-bar title="操作权限"/><view wx:if="{{isAdmin}}" class="cms-page"><cms-state loading="{{loading}}" error="{{error}}" bind:retry="load"/><block wx:if="{{!loading&&!error}}"><view class="cms-heading">{{name}}的操作权限</view><view class="cms-subtitle">按模块分配权限。未勾选的操作会在服务端拒绝。</view><view wx:for="{{rows}}" wx:key="id" wx:for-item="row" class="cms-card"><view class="cms-section-title">{{row.name}}</view><view class="permission-grid"><button wx:for="{{row.ops}}" wx:key="key" wx:for-item="op" class="permission-option {{op.checked?'selected':''}}" bindtap="toggle" data-module="{{row.id}}" data-op="{{op.key}}" aria-label="{{row.name}}：{{op.label}}，{{op.checked?'已选择':'未选择'}}"><text class="{{op.checked?'icon-roundcheckfill':'icon-round'}}"/>{{op.label}}</button></view></view><view class="cms-bottom"><button class="cms-button cms-primary" disabled="{{saving}}" loading="{{saving}}" bindtap="save">保存权限</button></view></block></view>
