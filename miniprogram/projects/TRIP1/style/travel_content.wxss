page{background:#f8f2f1;color:#39211b}.travel-hero{height:370rpx;position:relative;background:#ecdfdb}.travel-hero-image,.travel-hero-shade{position:absolute;inset:0;width:100%;height:100%}.travel-hero-shade{background:linear-gradient(180deg,transparent,rgba(33,20,16,.62))}.travel-hero-copy{position:absolute;bottom:58rpx;left:32rpx;right:32rpx;color:white;display:flex;flex-direction:column;gap:14rpx}.travel-hero-title{font-size:42rpx;font-weight:600;line-height:1.5}.travel-hero-subtitle{font-size:27rpx;line-height:1.6}.travel-body{position:relative;background:#fff;margin-top:-28rpx;border-radius:28rpx 28rpx 0 0;padding:30rpx 30rpx 40rpx}.travel-meta{display:flex;gap:30rpx;flex-wrap:wrap;font-size:24rpx;color:#897570;margin:0 0 30rpx}.travel-description,.travel-text{font-size:28rpx;line-height:1.85;color:#7b6a65;white-space:pre-wrap;word-break:break-all;display:block}.travel-section{margin-top:32rpx}.travel-section-title{display:block;font-size:34rpx;font-weight:600;margin-bottom:22rpx}.travel-highlights{display:flex;gap:16rpx;overflow:auto}.travel-highlight{width:145rpx;flex-shrink:0;text-align:center;font-size:24rpx;line-height:1.5}.travel-highlight image{width:145rpx;height:112rpx;border-radius:14rpx;display:block;margin-bottom:12rpx}.travel-itinerary{padding-left:10rpx}.travel-stop{background:white;border-radius:0;text-align:left;padding:12rpx 0;display:flex;gap:18rpx;align-items:center;min-height:128rpx;margin:0;position:relative;color:inherit;line-height:normal}.travel-stop:after{border:0}.travel-stop:before{content:'';position:absolute;left:19rpx;top:0;bottom:0;border-left:2rpx dashed #a97e72}.travel-stop-dot{position:relative;z-index:1;width:38rpx;height:38rpx;border-radius:50%;background:#a44736;color:white;display:flex;justify-content:center;align-items:center;font-size:20rpx;flex-shrink:0}.travel-stop image{width:94rpx;height:94rpx;border-radius:14rpx;flex-shrink:0}.travel-stop-copy{flex:1;min-width:0;display:flex;flex-direction:column;gap:12rpx}.travel-stop-copy text:first-child{font-size:29rpx;font-weight:600}.travel-stop-copy text:last-child{font-size:23rpx;color:#958b88;line-height:1.6}.travel-stop-time{font-size:23rpx;color:#91766f;max-width:120rpx}.travel-content-image{width:100%;border-radius:18rpx;margin:24rpx 0;display:block}.travel-footnote{display:block;text-align:center;font-size:23rpx;color:#ae9e9a;margin-top:40rpx}.travel-tabs{display:flex;justify-content:space-between;border-bottom:1rpx solid #f1eeed;margin:28rpx 0}.travel-tab{background:transparent;margin:0;padding:0 14rpx;border-radius:0;line-height:88rpx;min-height:88rpx;font-size:28rpx;color:#948885}.travel-tab:after{border:0}.travel-tab.active{color:#a44736;border-bottom:4rpx solid #a44736;font-weight:600}.travel-header-row{display:flex;align-items:center;justify-content:space-between}.travel-title{font-size:42rpx;font-weight:600;line-height:1.5}.travel-tip{margin-top:28rpx;background:#f5ecea;border-radius:18rpx;padding:26rpx;font-size:27rpx;line-height:1.8;color:#846c65}.travel-tip-title{display:block;font-size:30rpx;font-weight:600;color:#563329;margin-bottom:12rpx}.travel-gallery{display:flex;flex-wrap:wrap;gap:18rpx}.travel-gallery image{width:calc((100% - 18rpx)/2);height:220rpx;border-radius:16rpx}.travel-count{position:absolute;right:26rpx;bottom:48rpx;background:rgba(23,14,11,.45);color:white;border-radius:30rpx;padding:8rpx 18rpx;font-size:23rpx}.travel-bottom-space{height:50rpx}

.travel-hero{height:335rpx}.travel-body{padding:26rpx 28rpx 36rpx}.travel-hero-title{font-size:40rpx}.travel-description,.travel-text{font-size:27rpx;line-height:1.85}.travel-section-title{font-size:32rpx}.travel-meta{justify-content:space-between;gap:16rpx;font-size:23rpx}.travel-highlights{gap:14rpx}.travel-highlight{width:calc((100% - 42rpx)/4);font-size:23rpx}.travel-highlight image{width:100%;height:115rpx}.travel-stop:before{border-left:3rpx dotted #a44736}.travel-stop:first-child:before{top:50%}.travel-stop:last-child:before{bottom:50%}.travel-stop-copy text:first-child{font-size:28rpx}.travel-tabs .travel-tab{flex:1;padding:0 5rpx;text-align:center;font-size:27rpx}.travel-stop-time{flex-shrink:0}

.travel-tab{position:relative}.travel-tab.active{border-bottom:0}.travel-tab.active:before{content:"";position:absolute;left:25%;right:25%;bottom:0;height:4rpx;border-radius:4rpx;background:#a44736}
