@import "../../../../style/cms.wxss";
.cms-brand{width:100rpx;height:100rpx}.cms-stats{display:flex;flex-wrap:wrap;gap:16rpx;margin:24rpx 0 32rpx}.cms-stat{flex:1;min-width:130rpx;background:white;padding:24rpx 16rpx;border-radius:18rpx}.cms-stat-number{display:block;font-size:40rpx;font-weight:600;color:#a44736}.cms-module-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16rpx;margin-bottom:28rpx}.cms-module{background:white;border-radius:18rpx;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:18rpx;font-size:25rpx;min-height:180rpx;width:100%;padding:24rpx 8rpx;color:#452a23}.cms-module:after{border:1rpx solid #eee9e8}.cms-module-icon{font-size:44rpx;color:#a44736}.cms-settings-row{display:flex;align-items:center;gap:20rpx;min-height:96rpx;width:100%;font-size:28rpx;background:white;color:#4a3530;padding:0;text-align:left}.cms-settings-row:after{border:0}.cms-settings-row .icon-right{margin-left:auto;color:#9f908c}
