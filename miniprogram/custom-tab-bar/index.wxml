<view class="travel-tab-bar"><image class="tab-mountains" src="/projects/TRIP1/images/ui/tab_mountains.png" mode="scaleToFill"/><view class="travel-tabs"><button wx:for="{{tabs}}" wx:key="path" class="travel-tab {{selected==index?'selected':''}}" bindtap="switchTab" data-index="{{index}}" aria-label="{{item.text}}" aria-current="{{selected==index?'page':'false'}}"><image class="travel-tab-icon" src="{{selected==index?item.activeIcon:item.icon}}" mode="aspectFit"/><text>{{item.text}}</text></button></view></view>
