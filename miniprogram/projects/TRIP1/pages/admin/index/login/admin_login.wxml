<scenic-nav-bar title="管理后台" bind:layout="bindScenicLayout"/>
<view class="admin-login-page"><view class="admin-login-brand"><text>景区管理中心</text></view><view class="admin-login-card"><view class="wt-heading"><text class="wt-heading-title">管理员登录</text><text class="wt-heading-subtitle">登录后管理景区内容与客户反馈</text></view><view class="admin-login-field"><text>账号</text><input model:value="{{name}}" maxlength="30" placeholder="请输入管理员账号" aria-label="管理员账号"/></view><view class="admin-login-field"><text>密码</text><input model:value="{{pwd}}" maxlength="30" password placeholder="请输入管理员密码" aria-label="管理员密码"/></view><button class="admin-login-submit" bindtap="bindLoginTap">登录管理中心</button><button class="admin-login-back wt-card-button" bindtap="bindBackTap">返回用户端</button></view><view class="wt-footer">仅限景区管理员使用</view></view>
