@import "../../../../style/admin_ui.wxss";
.admin-login-page { min-height: 100vh; padding: 64rpx 32rpx; background: var(--wt-background); }
.admin-login-brand { margin: 24rpx 0 48rpx; text-align: center; color: var(--wt-brand); }
.admin-login-brand > text:first-child { display: block; font-size: 52rpx; font-weight: 700; }
.admin-login-brand > text:last-child { display: block; margin-top: 12rpx; font-size: 25rpx; }
.admin-login-card { background: white; border-radius: 28rpx; padding: 40rpx 32rpx; }
.admin-login-field { margin: 28rpx 0; }
.admin-login-field > text { display: block; margin-bottom: 16rpx; font-size: 28rpx; font-weight: 600; }
.admin-login-field input { background: var(--wt-background); height: 96rpx; padding: 0 24rpx; font-size: 28rpx; border-radius: 16rpx; }
.admin-login-submit { background: var(--wt-brand); color: white; border-radius: 48rpx; font-size: 30rpx; margin-top: 40rpx; }
.admin-login-submit::after { border: 0; }
.admin-login-back { width: 100%; padding: 24rpx; text-align: center; color: var(--wt-muted); font-size: 26rpx; margin-top: 12rpx; }
