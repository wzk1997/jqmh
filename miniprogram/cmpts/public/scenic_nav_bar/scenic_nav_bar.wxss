.scenic-nav{left:0;top:0;width:100%;z-index:80;box-sizing:border-box;pointer-events:none;color:#087f70}.is-fixed{position:fixed}.is-absolute{position:absolute}.scenic-nav-page{background:#fff;border-bottom:1rpx solid #edf4ef}.scenic-nav-home{background:transparent}.scenic-nav-immersive{background:transparent;color:white;text-shadow:0 1px 5px rgba(4,42,32,.25)}.scenic-nav-row{position:absolute;left:0;right:0;height:44px;padding-left:12px;box-sizing:border-box;display:flex;align-items:center}.scenic-nav-button{width:44px;min-width:44px;height:44px;padding:0;margin:0;background:transparent;color:inherit;display:flex;align-items:center;justify-content:center;line-height:1;font-size:40rpx;pointer-events:auto;border-radius:50%;box-sizing:border-box}.scenic-nav-button:after{border:0}.scenic-nav-button:active{background:rgba(8,127,112,.08)}.scenic-nav-immersive .scenic-nav-button:active{background:rgba(255,255,255,.13)}.scenic-nav-title{pointer-events:auto;position:absolute;top:0;line-height:44px;font-size:32rpx;font-weight:600;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;color:inherit}.scenic-nav-actions{margin-left:auto;display:flex;align-items:center;flex-shrink:0}.scenic-nav-home .scenic-nav-search{background:rgba(255,255,255,.86);width:44px;height:44px;margin:0;font-size:36rpx;box-shadow:0 2px 10px rgba(4,50,42,.05)}.scenic-nav-brand{display:flex;gap:8rpx;align-items:center;min-width:0;overflow:hidden;padding-right:8rpx;pointer-events:auto}.scenic-brand-image{width:60rpx;height:60rpx;flex-shrink:0}.scenic-brand-copy{display:flex;flex-direction:column;gap:2rpx;min-width:0}.scenic-brand-title{font-size:38rpx;font-weight:700;letter-spacing:-1rpx}.scenic-brand-subtitle{font-size:17rpx;letter-spacing:2rpx;color:#527f72;white-space:nowrap}.scenic-nav-slot{pointer-events:auto;flex-shrink:0}.scenic-nav-space{pointer-events:none;flex-shrink:0}

.scenic-nav-page{color:#173e43}.scenic-nav-page .scenic-nav-button{color:#146c60}

.scenic-business-round{background:rgba(255,255,255,.94);box-shadow:0 4rpx 14rpx rgba(28,79,67,.035)}

/* Home navigation follows the banner prototype while keeping a 44px search hit area. */
.scenic-nav-home .scenic-nav-row{padding-left:24rpx}
.scenic-nav-home .scenic-nav-brand{max-width:100%;color:#fff;text-shadow:0 1rpx 6rpx rgba(0,0,0,.25)}
.scenic-nav-home .scenic-brand-copy{gap:4rpx}
.scenic-nav-home .scenic-brand-title{font-family:"Snell Roundhand","Brush Script MT",cursive;font-size:36rpx;font-style:italic;font-weight:600;line-height:1.15;letter-spacing:0}
.scenic-nav-home .scenic-brand-subtitle{font-size:24rpx;line-height:1.2;letter-spacing:0;color:#fff;overflow:hidden;text-overflow:ellipsis}
.scenic-nav-home .scenic-nav-search{width:44px;height:44px;background:transparent;box-shadow:none}
.scenic-search-symbol{display:flex;align-items:center;justify-content:center}
.scenic-nav-home .scenic-search-symbol{width:56rpx;height:56rpx;border-radius:50%;background:rgba(255,255,255,.8);color:#0e7a5f;font-size:24rpx}
