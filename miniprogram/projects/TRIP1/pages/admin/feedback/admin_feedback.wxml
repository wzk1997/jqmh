<scenic-nav-bar title="客户反馈"/><view wx:if="{{isAdmin}}" class="cms-page"><view class="cms-heading">客户反馈</view><text class="cms-subtitle">倾听游客，持续改善游览体验</text><view class="cms-search"><text class="icon-search"/><input class="cms-search-input" value="{{search}}" bindinput="inputSearch" bindconfirm="search" maxlength="50" placeholder="搜索反馈内容或联系电话"/><button class="cms-button cms-link" bindtap="search">搜索</button></view><view class="cms-tabs"><button wx:for="{{tabs}}" wx:key="id" class="cms-tab {{status===item.id?'cms-tab-active':''}}" bindtap="filter" data-status="{{item.id}}">{{item.name}}</button></view><cms-state loading="{{loading && !records.length}}" error="{{error}}" empty="{{!loading&&!error&&!records.length}}" emptyText="暂无游客反馈" bind:retry="load"/><button wx:for="{{records}}" wx:key="_id" class="cms-list-button" bindtap="detail" data-id="{{item._id}}"><view class="cms-row"><text class="cms-name cms-row-copy">{{item.FEEDBACK_CATEGORY}}</text><text class="cms-badge {{item.FEEDBACK_STATUS===1?'cms-badge-published':'cms-badge-draft'}}">{{item.statusName}}</text></view><text class="cms-feedback-excerpt">{{item.FEEDBACK_CONTENT}}</text><text class="cms-meta">{{item.date}} {{item.FEEDBACK_PHONE}}</text></button><text wx:if="{{hasMore}}" class="cms-meta">{{loading?'正在加载…':'上拉加载更多'}}</text></view>
