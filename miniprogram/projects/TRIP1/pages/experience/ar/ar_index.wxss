@import "../../../style/design_v3.wxss";
.ar-page{height:100vh;position:relative;background:#123c30;color:white;overflow:hidden}.ar-scene{position:absolute;width:100%;height:100%}.ar-page:before{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,36,20,.4),transparent 45%,rgba(0,30,20,.3));pointer-events:none}.ar-intro{position:relative;margin:25rpx 32rpx;display:flex;flex-direction:column;gap:14rpx;text-shadow:0 1px 4px #123c30}.ar-intro>text:first-child{font-size:32rpx;font-weight:600}.ar-intro>text:last-child{font-size:23rpx}.ar-controls{position:absolute;right:25rpx;top:46%;display:flex;flex-direction:column;gap:20rpx}.ar-controls button{border-radius:50%;width:85rpx;height:85rpx;background:rgba(255,255,255,.94);color:#146f61;font-size:38rpx;padding:0;line-height:85rpx}.ar-chevrons{position:absolute;left:32%;bottom:33%;display:flex;flex-direction:column;gap:18rpx;transform:perspective(250rpx) rotateX(28deg)}.ar-chevrons view{width:260rpx;height:75rpx;background:rgba(98,246,211,.68);clip-path:polygon(0 100%,50% 0,100% 100%,50% 50%)}.ar-sheet{position:absolute;bottom:40rpx;left:25rpx;right:25rpx;border-radius:26rpx;padding:24rpx;background:rgba(255,255,255,.96);color:#243d34}.ar-sheet-top{display:flex;align-items:center;gap:18rpx}.ar-sheet-top image{width:92rpx;height:92rpx;border-radius:50%}.ar-sheet-top>view{display:flex;flex:1;min-width:0;flex-direction:column;gap:10rpx}.ar-sheet-top>view>text:first-child{font-size:28rpx;font-weight:600}.ar-sheet-top>view>text:last-child{font-size:21rpx;color:#84988b}.ar-sheet-top button{background:#0e8473;color:white;font-size:20rpx;padding:0 18rpx;line-height:62rpx;border-radius:32rpx}.ar-actions{display:flex;gap:20rpx;margin-top:24rpx}.ar-actions button{flex:1;font-size:24rpx;color:#0a8070;background:#edf5f0;border-radius:38rpx}.ar-actions button:last-child{background:#087f70;color:white}.ar-error{display:block;color:#b75639;font-size:22rpx;margin-top:18rpx}
