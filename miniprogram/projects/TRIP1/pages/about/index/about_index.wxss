@import "../../../style/design_v3.wxss";
page{background:#fff}.intro-hero{height:650rpx;position:relative;color:white}.intro-hero>image,.intro-shade{position:absolute;width:100%;height:100%}.intro-shade{background:linear-gradient(180deg,rgba(52,31,25,.2),transparent 30%,rgba(32,19,16,.53))}.intro-poem{position:absolute;bottom:65rpx;right:32rpx;left:32rpx;text-align:right;display:flex;flex-direction:column;gap:18rpx}.intro-poem>text:first-child{font-family:STSong,serif;font-size:calc(45rpx * var(--wt-font-scale, 1));font-weight:600;letter-spacing:3rpx}.intro-poem>text:last-child{font-size:calc(23rpx * var(--wt-font-scale, 1));letter-spacing:2rpx}.intro-ribbon{background:#f1eae8;color:#7b5a51;text-align:center;font-size:calc(25rpx * var(--wt-font-scale, 1));letter-spacing:7rpx;padding:28rpx}.intro-body{padding:36rpx 30rpx}.intro-heading{display:flex;flex-direction:column;gap:12rpx;margin-bottom:25rpx}.intro-heading>text:first-child{font-size:calc(37rpx * var(--wt-font-scale, 1));font-weight:650}.intro-heading>text:last-child{font-size:calc(22rpx * var(--wt-font-scale, 1));color:#a3938f}.intro-text{display:block;font-size:calc(27rpx * var(--wt-font-scale, 1));color:#8a7f7c;line-height:1.9;white-space:pre-wrap;margin-bottom:25rpx}.intro-content>image{width:100%;border-radius:18rpx;display:block;margin:22rpx 0}.intro-content.collapsed{max-height:370rpx;overflow:hidden;position:relative}.intro-content.collapsed:after{content:"";position:absolute;left:0;right:0;bottom:0;height:65rpx;background:linear-gradient(transparent,white)}.intro-expand{background:transparent;color:#855f55;font-size:calc(24rpx * var(--wt-font-scale, 1));line-height:80rpx}.intro-values{display:flex;gap:14rpx;margin:18rpx 0 30rpx}.intro-values>view{flex:1;display:flex;flex-direction:column;align-items:center;gap:14rpx;border-radius:14rpx;background:#f7f4f3;padding:26rpx 8rpx;font-size:calc(23rpx * var(--wt-font-scale, 1));color:#7f6e69}.intro-values>view>text:first-child{font-size:calc(36rpx * var(--wt-font-scale, 1));color:#975948}.intro-landscape{width:100%;height:330rpx;border-radius:20rpx}.intro-feedback{font-size:calc(24rpx * var(--wt-font-scale, 1));background:#f5efed;color:#865e53;border-radius:16rpx;margin-top:28rpx}

.intro-facts{display:flex;flex-direction:column;gap:20rpx;font-size:calc(28rpx * var(--wt-font-scale, 1));line-height:1.8;margin:24rpx 0;color:#6c5b57}.intro-facts button{background:#f4e9e6;color:#a44736;font-size:calc(28rpx * var(--wt-font-scale, 1));min-height:88rpx;border-radius:16rpx}

.scenic-cover{height:calc(100vh - 30px);min-height:1000rpx;position:relative;color:#fff;background:#a44736}.scenic-cover>image,.cover-gradient{position:absolute;width:100%;height:100%}.cover-gradient{background:linear-gradient(180deg,rgba(26,16,13,.15),transparent 30%,rgba(26,16,13,.65))}.cover-brand{position:absolute;top:40%;left:44rpx;right:44rpx;text-align:center;display:flex;flex-direction:column;gap:20rpx;font-size:calc(28rpx * var(--wt-font-scale, 1));letter-spacing:4rpx}.cover-name{font-family:STSong,serif;font-size:calc(64rpx * var(--wt-font-scale, 1));letter-spacing:8rpx}.cover-bottom{position:absolute;bottom:48rpx;left:0;right:0;text-align:center;display:flex;flex-direction:column;gap:20rpx;font-size:calc(28rpx * var(--wt-font-scale, 1))}.cover-bottom>text{font-size:calc(22rpx * var(--wt-font-scale, 1));opacity:.85}.scenic-film{position:absolute;top:58%;left:20%;width:60%;height:220rpx;border-radius:20rpx}.scenic-tabs{position:sticky;z-index:20;background:rgba(255,255,255,.98);display:flex;border-bottom:1rpx solid #f2eeed;padding:8rpx 10rpx}.scenic-tabs button{padding:0 5rpx;min-height:88rpx;line-height:88rpx;flex:1;font-size:calc(23rpx * var(--wt-font-scale, 1));background:transparent;white-space:nowrap;color:#7c8794;border-radius:0}.scenic-tabs button.active{color:#a44736;font-weight:600;box-shadow:inset 0 -4rpx #a44736}.scenic-body{padding:30rpx;background:#faf7f2}.scenic-section{padding:18rpx 0 54rpx}.section-title{display:block;font-size:calc(36rpx * var(--wt-font-scale, 1));font-weight:600;color:#3e251e;margin:12rpx 0 26rpx}.scenic-wide{width:100%;height:390rpx;border-radius:20rpx;display:block}.scenic-summary{position:relative;margin-top:-32rpx;background:#fff;border-radius:22rpx;padding:28rpx;margin-bottom:38rpx}.scenic-address{display:block;background:#f9f7f6;padding:20rpx;font-size:calc(24rpx * var(--wt-font-scale, 1));color:#788790;border-radius:14rpx}.scenic-facts{display:flex;justify-content:space-around;margin-top:28rpx}.scenic-facts>view{flex:1;display:flex;flex-direction:column;align-items:center;gap:10rpx;font-size:calc(23rpx * var(--wt-font-scale, 1));color:#908784}.scenic-facts>view>text:first-child{font-size:calc(31rpx * var(--wt-font-scale, 1));color:#a44736;font-weight:600}.scenic-copy{display:block;white-space:pre-wrap;font-size:calc(27rpx * var(--wt-font-scale, 1));line-height:1.9;color:#837673;margin:12rpx 0}.scenic-expand{background:transparent;color:#a44736;text-align:right;font-size:calc(26rpx * var(--wt-font-scale, 1));min-height:88rpx}.card-title{display:block;font-size:calc(30rpx * var(--wt-font-scale, 1));font-weight:600;color:#37201a;margin:20rpx 0 10rpx}.scenic-story{margin-bottom:32rpx;background:#fff;border-radius:20rpx;padding:0 0 20rpx;overflow:hidden}.scenic-story>text{margin-left:22rpx;margin-right:22rpx}.scenic-empty{display:block;color:#988c89;font-size:calc(26rpx * var(--wt-font-scale, 1));padding:28rpx 0}.practical-card{background:#fff;border-radius:20rpx;padding:26rpx;margin-bottom:22rpx}.practical-card>.card-title{margin-top:0}.scenic-outline{background:#fff;border:1rpx solid #7c493c;color:#a44736;border-radius:44rpx;font-size:calc(26rpx * var(--wt-font-scale, 1));min-height:88rpx;line-height:88rpx;margin-top:20rpx}.scenic-map{width:100%;height:270rpx;border-radius:18rpx;margin-top:24rpx}.traffic-title{display:block;font-weight:600;font-size:calc(27rpx * var(--wt-font-scale, 1));margin-top:28rpx}.scenic-feedback{background:#a44736;color:#fff;font-size:calc(27rpx * var(--wt-font-scale, 1));min-height:88rpx;border-radius:44rpx}

.scenic-preview-label{display:block;background:#fff2d8;color:#966723;font-size:calc(24rpx * var(--wt-font-scale, 1));padding:20rpx;border-radius:12rpx;margin-bottom:24rpx}

.scenic-facts>view{text-align:center;padding:0 8rpx;word-break:break-word}
