<wxs module="media" src="../../../../../../wxs/media.wxs"/>
<scenic-nav-bar title="{{title}}"/><view wx:if="{{isAdmin}}" class="cms-page"><cms-state loading="{{loading}}" error="{{error}}" bind:retry="load"/><block wx:if="{{!loading && !error}}"><view class="cms-card"><view class="cms-section-title">基本信息</view><view class="cms-field"><text class="cms-label">{{module==='merchant'?'商家名称':module==='category'?'分类名称':'标题'}} *</text><input class="cms-input" value="{{form.name}}" data-field="name" bindinput="input" maxlength="{{module==='news'||module==='album'||module==='product'?50:80}}" placeholder="请输入名称或标题"/></view><view wx:if="{{categories.length}}" class="cms-field"><text class="cms-label">分类 *</text><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category"><view class="cms-input">{{categories[categoryIndex].name}} <text class="icon-unfold"/></view></picker></view><view wx:if="{{module==='merchant'}}" class="cms-field"><text class="cms-label">商家类型 *</text><picker range="{{merchantTypes}}" range-key="name" value="{{categoryIndex}}" bindchange="merchantCategory"><view class="cms-input">{{form.category==='food'?'餐饮':form.category==='stay'?'住宿':'交通'}}</view></picker></view><view wx:if="{{module==='category'}}" class="cms-field"><text class="cms-label">分类编号 *</text><input class="cms-input" value="{{form.key}}" data-field="key" bindinput="input" maxlength="80" disabled="{{!!id}}" placeholder="使用字母、数字或下划线"/></view><view wx:if="{{module!=='category'}}" class="cms-field"><text class="cms-label">简介</text><textarea class="cms-input cms-textarea" value="{{form.desc}}" data-field="desc" bindinput="input" maxlength="{{module==='news'?200:500}}" auto-height placeholder="简要介绍内容"/></view><view wx:if="{{module==='scenic'||module==='merchant'||module==='product'}}"><view wx:if="{{module!=='product'}}" class="cms-field"><text class="cms-label">联系电话</text><input class="cms-input" value="{{form.phone}}" data-field="phone" bindinput="input" maxlength="30" placeholder="手机或固定电话"/></view><view class="cms-field"><text class="cms-label">详细地址</text><input class="cms-input" value="{{form.address}}" data-field="address" bindinput="input" maxlength="300" placeholder="请输入详细地址"/></view><view class="cms-field"><text class="cms-label">{{module==='merchant'?'营业时间':'开放时间'}}</text><input class="cms-input" value="{{form.hours}}" data-field="hours" bindinput="input" maxlength="100" placeholder="如 08:00–18:00"/></view></view><view wx:if="{{module==='news'}}"><view class="cms-field"><text class="cms-label">活动开始日期（可选）</text><picker mode="date" value="{{form.activityStart}}" data-field="activityStart" bindchange="date"><view class="cms-input">{{form.activityStart||'选择日期'}}</view></picker></view><view class="cms-field"><text class="cms-label">活动结束日期（可选）</text><picker mode="date" value="{{form.activityEnd}}" data-field="activityEnd" bindchange="date"><view class="cms-input">{{form.activityEnd||'选择日期'}}</view></picker></view></view><view class="cms-field"><text class="cms-label">展示排序</text><input class="cms-input" type="number" value="{{form.order}}" data-field="order" bindinput="input" maxlength="4"/><text class="cms-meta">数字越小，展示越靠前</text></view></view><view wx:if="{{module!=='category'}}" class="cms-card"><view class="cms-section-title">{{module==='scenic'||module==='merchant'?'展示图片':'封面图片'}}</view><cmpt-img-upload id="cmsImages" media-urls="{{mediaUrls}}" imgMax="{{module==='scenic'||module==='merchant'||module==='product'?10:module==='news'?3:1}}" imgList="{{images}}" bind:upload="images" isCheck="{{false}}" imgUploadSize="{{5}}" title="上传图片"/><text class="cms-upload-hint">支持 JPG、PNG，单张不超过 5MB</text></view><scenic-info-editor media-urls="{{mediaUrls}}" wx:if="{{module==='scenic'}}" id="scenicInfo" info="{{scenicInfo}}" images="{{images}}"/><view wx:if="{{module==='product'}}" class="cms-card"><view class="cms-section-title">景点详情信息</view><view wx:for="{{['subtitle','distance','duration','bestTime','other']}}" wx:key="*this" class="cms-field"><text class="cms-label">{{item==='subtitle'?'简短副标题':item==='distance'?'游览距离（选填）':item==='duration'?'建议游览时长（选填）':item==='bestTime'?'最佳游览时间（选填）':'游览贴士'}}</text><textarea class="cms-input cms-textarea" value="{{form[item]}}" bindinput="input" data-field="{{item}}" maxlength="{{item==='other'?2000:300}}" auto-height/></view></view><view wx:if="{{module==='album'}}" class="cms-card"><text class="cms-label">建议游玩时长（选填）</text><input class="cms-input" value="{{form.duration}}" data-field="duration" bindinput="input" maxlength="50" placeholder="如 约3小时、两天一晚"/><view class="cms-section-title">关联景点</view><view wx:if="{{routeOrder.length}}" class="cms-route-order"><text class="cms-label">行程顺序</text><view wx:for="{{routeOrder}}" wx:key="id" class="cms-row"><text class="cms-row-copy">{{index+1}}. {{item.name}}</text><button class="cms-button cms-link" bindtap="moveSpot" data-index="{{index}}" data-delta="-1" disabled="{{index===0}}" aria-label="向上移动景点">上移</button><button class="cms-button cms-link" bindtap="moveSpot" data-index="{{index}}" data-delta="1" disabled="{{index===routeOrder.length-1}}" aria-label="向下移动景点">下移</button></view></view><view class="cms-checks"><button wx:for="{{spots}}" wx:key="id" class="cms-button cms-link cms-check" bindtap="spot" data-id="{{item.id}}"><text class="{{item.checked?'icon-roundcheckfill':'icon-round'}}"/>{{item.name}} <text wx:if="{{item.available===false}}">（请移除无效关联）</text></button><view wx:if="{{item.checked}}" wx:for="{{spots}}" wx:key="id" class="cms-field"><text class="cms-label">{{item.name}} · 行程说明</text><input class="cms-input" value="{{item.highlight}}" bindinput="routeInput" data-id="{{item.id}}" data-field="highlight" maxlength="30" placeholder="路线亮点名称，如 湖光山色（选填）"/><input class="cms-input" value="{{item.duration}}" bindinput="routeInput" data-id="{{item.id}}" data-field="duration" maxlength="50" placeholder="停留时间（选填）"/><input class="cms-input" value="{{item.note}}" bindinput="routeInput" data-id="{{item.id}}" data-field="note" maxlength="300" placeholder="游览建议（选填）"/></view></view><text wx:if="{{spotsLoading}}" class="cms-meta">正在加载景点…</text><button wx:if="{{spotsError}}" class="cms-button cms-secondary" bindtap="retrySpots">重新加载景点</button><button wx:elif="{{spotsHasMore}}" class="cms-button cms-secondary" bindtap="loadMoreSpots" disabled="{{spotsLoading}}">加载更多景点</button><text wx:if="{{!spots.length&&!spotsLoading&&!spotsError}}" class="cms-meta">暂无已发布景点，可先保存攻略</text></view><view wx:if="{{module!=='category'}}" class="cms-card"><view class="cms-section-title">图文内容</view><cmpt-editor media-urls="{{mediaUrls}}" formatting="{{true}}" inlineToolbar="{{true}}" id="cmsEditor" imageMaxMB="{{5}}" textMaxLength="{{10000}}" nodeList="{{content}}" viewMode="{{true}}"/></view><text wx:if="{{formError}}" class="cms-field-error">{{formError}}</text><view class="cms-bottom"><button class="cms-button cms-secondary" bindtap="save" disabled="{{saving}}" loading="{{saving}}">保存草稿</button><button wx:if="{{canPublish}}" class="cms-button cms-primary" bindtap="save" data-publish="true" disabled="{{saving}}">发布</button></view></block></view>
