<page-meta page-style="--wt-font-scale:{{wtFontScale||1}};--wt-entry-caption-lines:{{wtFontScale>1?2:1}};--wt-entry-title-bottom:{{wtFontScale>1?62:31}}rpx;"/>
<wxs module="media" src="../../../../../wxs/media.wxs"/>
<wxs module="rich" src="../../../../../wxs/rich_text.wxs"/>
<scenic-nav-bar title="商家详情"/><view class="cms-page {{wtDisplayMode==='enlarged'?'display-enlarged':''}}"><cms-state loading="{{loading}}" error="{{error}}" bind:retry="load"/><block wx:if="{{record&&!loading&&!error}}"><image wx:if="{{record.MERCHANT_IMAGES[0]}}" class="cms-hero" src="{{media.display(record.MERCHANT_IMAGES[0],mediaUrls)}}" mode="aspectFill" bindtap="preview" data-url="{{record.MERCHANT_IMAGES[0]}}"/><view class="cms-card"><view class="cms-heading">{{record.MERCHANT_NAME}}</view><text class="cms-subtitle">{{record.MERCHANT_CATEGORY==='food'?'美食餐饮':record.MERCHANT_CATEGORY==='stay'?'住宿推荐':'出行服务'}}</text><view wx:if="{{record.MERCHANT_DEMO}}" class="demo-notice">演示商家 · 不提供实际联系方式</view><view class="cms-detail-text">{{record.MERCHANT_DESC}}</view><view class="cms-rule"/><view wx:if="{{!record.MERCHANT_DEMO}}" class="cms-fact"><text class="cms-fact-label">联系电话</text><text user-select>{{record.MERCHANT_PHONE}}</text></view><view class="cms-fact"><text class="cms-fact-label">详细地址</text><text user-select>{{record.MERCHANT_ADDRESS}}</text></view><view wx:if="{{record.MERCHANT_HOURS}}" class="cms-fact"><text class="cms-fact-label">营业时间</text><text>{{record.MERCHANT_HOURS}}</text></view></view><view class="cms-card"><block wx:for="{{record.MERCHANT_CONTENT}}" wx:key="index"><text wx:if="{{item.type==='text'}}" class="cms-detail-text" style="{{rich.style(item)}}">{{item.val}}</text><image wx:else class="cms-body-image" src="{{media.display(item.val,mediaUrls)}}" mode="widthFix"/></block><view class="cms-photo-grid"><image wx:for="{{record.MERCHANT_IMAGES}}" wx:key="*this" class="cms-photo" src="{{media.display(item,mediaUrls)}}" mode="aspectFill" bindtap="preview" data-url="{{item}}"/></view></view><view wx:if="{{!record.MERCHANT_DEMO}}" class="cms-bottom"><button class="cms-button cms-primary" bindtap="phone"><text class="icon-phone"/> 电话联系</button></view></block></view>
<reading-tools id="readingTools"/>
